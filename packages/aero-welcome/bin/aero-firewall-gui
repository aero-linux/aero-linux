#!/usr/bin/env python3
"""
Aero Linux - Graphical Firewall & Security Shield Studio
Zero-terminal UFW firewall manager, incoming/outgoing port rules controller, and security shield.
"""

import os
import shutil
import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


def get_ufw_rules():
    status = {"active": False, "rules": []}
    res = subprocess.run(["ufw", "status", "numbered"], capture_output=True, text=True)
    if "Status: active" in res.stdout:
        status["active"] = True

    lines = res.stdout.splitlines()
    for line in lines:
        if line.startswith("[") and "]" in line:
            parts = line.split("]", 1)
            num = parts[0].replace("[", "").strip()
            rule_str = parts[1].strip()
            
            rule_parts = rule_str.split()
            if len(rule_parts) >= 2:
                to_port = rule_parts[0]
                action = rule_parts[1]
                from_addr = " ".join(rule_parts[2:]) if len(rule_parts) > 2 else "Anywhere"
                status["rules"].append({
                    "num": num,
                    "to": to_port,
                    "action": action,
                    "from": from_addr,
                    "raw": line
                })
    return status


class FirewallStudioWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Firewall & Shield Studio")
        self.set_default_size(660, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Styling
        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #10b981; }
        .card { background-color: #111827; border-radius: 10px; padding: 12px 16px; border: 1px solid #1f2937; }
        .btn-add { background-color: #10b981; color: #000000; font-weight: bold; border-radius: 6px; padding: 6px 14px; font-size: 12px; }
        .btn-del { background-color: #7f1d1d; color: #fca5a5; font-weight: bold; border-radius: 6px; padding: 4px 10px; font-size: 11px; }
        .btn-del:hover { background-color: #991b1b; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>🛡️ Aero Firewall &amp; Shield</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#9ca3af' font='10'>Control network firewall rules, allow developer ports &amp; block unauthorized traffic</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        # Master Firewall Switch
        self.switch_fw = Gtk.Switch()
        self.switch_fw.connect("state-set", self._on_toggle_firewall)
        header_box.pack_start(self.switch_fw, False, False, 0)

        vbox.pack_start(header_box, False, False, 0)

        # Actions bar
        act_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_rules_title = Gtk.Label(label="<b>Active Port Rules</b>", xalign=0)
        lbl_rules_title.set_use_markup(True)
        act_box.pack_start(lbl_rules_title, True, True, 0)

        btn_add = Gtk.Button(label="➕ Allow Port")
        btn_add.get_style_context().add_class("btn-add")
        btn_add.connect("clicked", self._on_add_rule_dialog)
        act_box.pack_start(btn_add, False, False, 0)

        vbox.pack_start(act_box, False, False, 0)

        # Scrolled Rules List
        scrolled = Gtk.ScrolledWindow()
        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scrolled.add(self.list_box)
        vbox.pack_start(scrolled, True, True, 0)

        # Status
        self.lbl_status = Gtk.Label(label="Ready", xalign=0)
        vbox.pack_start(self.lbl_status, False, False, 0)

        self._load_rules()

    def _load_rules(self):
        def run():
            data = get_ufw_rules()
            GLib.idle_add(self._display_rules, data)

        threading.Thread(target=run, daemon=True).start()

    def _display_rules(self, data):
        self.switch_fw.set_active(data["active"])
        for child in self.list_box.get_children():
            self.list_box.remove(child)

        if not data["rules"]:
            lbl_empty = Gtk.Label(label="No custom firewall port rules configured.", xalign=0.5)
            lbl_empty.set_markup("<span color='#94a3b8'>No active rules. Incoming connections follow system defaults.</span>")
            self.list_box.pack_start(lbl_empty, True, True, 20)
        else:
            for r in data["rules"]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.get_style_context().add_class("card")

                action_color = "#10b981" if "ALLOW" in r["action"].upper() else "#f43f5e"
                
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                lbl_p = Gtk.Label(xalign=0)
                lbl_p.set_markup(f"<b color='{action_color}'>{r['action'].upper()}</b> ➔ <span font='bold 12'>{r['to']}</span>")
                lbl_d = Gtk.Label(xalign=0)
                lbl_d.set_markup(f"<span color='#9ca3af' font='9'>Source: {r['from']} (Rule #{r['num']})</span>")
                info.pack_start(lbl_p, False, False, 0)
                info.pack_start(lbl_d, False, False, 0)
                row.pack_start(info, True, True, 0)

                btn_del = Gtk.Button(label="🗑️ Delete")
                btn_del.get_style_context().add_class("btn-del")
                btn_del.connect("clicked", lambda b, num=r['num']: self._delete_rule(num))
                row.pack_start(btn_del, False, False, 0)

                self.list_box.pack_start(row, False, False, 0)

        self.list_box.show_all()
        status_text = "Active & Shielding" if data["active"] else "Inactive (Disabled)"
        status_color = "#10b981" if data["active"] else "#94a3b8"
        self.lbl_status.set_markup(f"<span color='{status_color}' font='10'>Firewall Status: <b>{status_text}</b> — {len(data['rules'])} rule(s) active</span>")

    def _on_toggle_firewall(self, switch, state):
        cmd = "pkexec ufw enable" if state else "pkexec ufw disable"
        subprocess.run(cmd, shell=True)
        self._load_rules()
        subprocess.run(["notify-send", "🛡️ Firewall Shield", f"Firewall {'enabled' if state else 'disabled'}."])
        return False

    def _delete_rule(self, num):
        subprocess.run(f"echo y | pkexec ufw delete {num}", shell=True)
        self._load_rules()
        subprocess.run(["notify-send", "🛡️ Firewall Shield", f"Deleted rule #{num}."])

    def _on_add_rule_dialog(self, button):
        dialog = Gtk.Dialog(title="Allow Port / Service", parent=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_ADD, Gtk.ResponseType.OK)
        dialog.set_default_size(360, 180)
        dialog.set_border_width(12)

        content = dialog.get_content_area()
        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)

        lbl_p = Gtk.Label(label="Port / Service:", xalign=0)
        entry_port = Gtk.Entry()
        entry_port.set_placeholder_text("e.g. 8080, 3000, 5432, ssh")

        lbl_pr = Gtk.Label(label="Protocol:", xalign=0)
        combo_proto = Gtk.ComboBoxText()
        combo_proto.append_text("tcp")
        combo_proto.append_text("udp")
        combo_proto.append_text("any")
        combo_proto.set_active(0)

        grid.attach(lbl_p, 0, 0, 1, 1)
        grid.attach(entry_port, 1, 0, 1, 1)
        grid.attach(lbl_pr, 0, 1, 1, 1)
        grid.attach(combo_proto, 1, 1, 1, 1)

        content.add(grid)
        dialog.show_all()

        if dialog.run() == Gtk.ResponseType.OK:
            port = entry_port.get_text().strip()
            proto = combo_proto.get_active_text()
            if port:
                rule_arg = f"{port}/{proto}" if proto != "any" else port
                subprocess.run(f"pkexec ufw allow {rule_arg}", shell=True)
                self._load_rules()
                subprocess.run(["notify-send", "🛡️ Firewall Shield", f"Allowed port {rule_arg}."])
        dialog.destroy()


def main():
    win = FirewallStudioWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
