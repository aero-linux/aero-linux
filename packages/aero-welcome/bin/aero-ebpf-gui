#!/usr/bin/env python3
"""
Aero Linux - Graphical eBPF & Kernel Socket Lifecycle Inspector
Real-time dashboard of kernel tracing readiness, active network sockets, packet flow, and socket lifecycles.
"""

import os
import shutil
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

from aero.tracer import audit_ebpf_kernel_support, trace_active_sockets, trace_tcp_tls_latency


class EbpfInspectorWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero eBPF & Kernel Socket Inspector")
        self.set_default_size(780, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #111827; border-radius: 10px; padding: 12px; border: 1px solid #1f2937; }
        .badge-active { background-color: #059669; color: #ffffff; border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: bold; }
        .badge-inactive { background-color: #4b5563; color: #d1d5db; border-radius: 4px; padding: 2px 8px; font-size: 11px; }
        .btn-refresh { background-color: #00f2fe; color: #000000; font-weight: bold; border-radius: 6px; padding: 6px 14px; font-size: 12px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(main_box)

        # Header
        hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        title = Gtk.Label(label="⚡ eBPF Kernel & Socket Lifecycle Inspector")
        title.get_style_context().add_class("header-title")
        hdr_box.pack_start(title, False, False, 0)

        refresh_btn = Gtk.Button(label="🔄 Refresh Sockets")
        refresh_btn.get_style_context().add_class("btn-refresh")
        refresh_btn.connect("clicked", lambda b: self.refresh_data())
        hdr_box.pack_end(refresh_btn, False, False, 0)
        main_box.pack_start(hdr_box, False, False, 0)

        # eBPF Status Banner
        self.status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        self.status_box.get_style_context().add_class("card")
        main_box.pack_start(self.status_box, False, False, 0)

        # Filter bar
        filter_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        filter_label = Gtk.Label(label="Process Filter:")
        filter_box.pack_start(filter_label, False, False, 0)
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Filter sockets by process (e.g. node, python, curl)...")
        self.search_entry.connect("search-changed", lambda e: self.filter_sockets())
        filter_box.pack_start(self.search_entry, True, True, 0)
        main_box.pack_start(filter_box, False, False, 0)

        # Sockets TreeView
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroller.set_shadow_type(Gtk.ShadowType.ETCHED_IN)
        main_box.pack_start(scroller, True, True, 0)

        self.store = Gtk.ListStore(str, str, str, str)
        self.tree = Gtk.TreeView(model=self.store)

        cols = [
            ("TCP State", 0, 110),
            ("Local Address", 1, 200),
            ("Foreign Peer Address", 2, 200),
            ("Process / PID", 3, 220),
        ]
        for title_text, col_id, width in cols:
            renderer = Gtk.CellRendererText()
            col = Gtk.TreeViewColumn(title_text, renderer, text=col_id)
            col.set_min_width(width)
            col.set_resizable(True)
            self.tree.append_column(col)

        scroller.add(self.tree)
        self.all_sockets = []
        self.refresh_data()

    def refresh_data(self):
        # Update eBPF status
        status = audit_ebpf_kernel_support()
        for child in self.status_box.get_children():
            self.status_box.remove(child)

        lbl = Gtk.Label(label=f"Kernel TraceFS: {'Active' if status['tracefs'] else 'Unmounted'}  |  "
                              f"BPF FS: {'Active' if status['bpf_fs'] else 'Missing'}  |  "
                              f"bpftool: {'Installed' if status['bpftool'] else 'Missing'}")
        self.status_box.pack_start(lbl, False, False, 0)
        self.status_box.show_all()

        # Update sockets
        self.all_sockets = trace_active_sockets()
        self.filter_sockets()

    def filter_sockets(self):
        query = self.search_entry.get_text().strip().lower()
        self.store.clear()
        for s in self.all_sockets:
            if not query or query in s["process"].lower() or query in s["local"].lower() or query in s["peer"].lower():
                self.store.append([
                    s.get("state", "ESTAB"),
                    s.get("local", ""),
                    s.get("peer", ""),
                    s.get("process", "-")
                ])


def main():
    win = EbpfInspectorWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
