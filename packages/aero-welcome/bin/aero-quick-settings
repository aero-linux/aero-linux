#!/usr/bin/env python3
"""
Aero Linux - Unified Quick-Settings Action Center
Lightweight GTK3 popover with frosted glass styling, quick tiles, and sliders.
"""

import os
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib


CSS = b"""
window {
    background-color: rgba(10, 11, 16, 0.92);
    border: 1px solid rgba(0, 242, 254, 0.35);
    border-radius: 16px;
}

.action-tile {
    background: rgba(22, 27, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 10px 14px;
    color: #f0f6fc;
    font-weight: 600;
    font-size: 13px;
    transition: all 0.2s ease;
}

.action-tile:hover {
    background: rgba(0, 242, 254, 0.15);
    border-color: rgba(0, 242, 254, 0.45);
    color: #00f2fe;
}

.action-tile-active {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.25), rgba(79, 172, 254, 0.25));
    border: 1px solid #00f2fe;
    color: #00f2fe;
}

scale trough {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    min-height: 8px;
}

scale highlight {
    background: linear-gradient(90deg, #00f2fe, #4facfe);
    border-radius: 8px;
}

scale slider {
    background-color: #00f2fe;
    border-radius: 50%;
    min-width: 18px;
    min-height: 18px;
}

label.section-header {
    color: #8b949e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
"""


class QuickSettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Action Center")
        self.set_default_size(360, 440)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_keep_above(True)

        # Style provider
        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        # Main Layout Box
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        vbox.set_margin_top(18)
        vbox.set_margin_bottom(18)
        vbox.set_margin_start(18)
        vbox.set_margin_end(18)
        self.add(vbox)

        # Header with Title & Close
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_title = Gtk.Label()
        lbl_title.set_markup("<span font='13' weight='bold' color='#00f2fe'>⚡ Quick Settings</span>")
        header.pack_start(lbl_title, False, False, 0)

        btn_close = Gtk.Button(label="✕")
        btn_close.get_style_context().add_class("action-tile")
        btn_close.connect("clicked", lambda b: self.destroy())
        header.pack_end(btn_close, False, False, 0)
        vbox.pack_start(header, False, False, 0)

        # 2x4 Quick-Action Tiles Grid
        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        self.btn_wifi = Gtk.Button(label="📶 Wi-Fi\n<span font='9' color='#34d399'>Connected</span>")
        self.btn_wifi.get_child().set_use_markup(True)
        self.btn_wifi.get_style_context().add_class("action-tile")
        self.btn_wifi.connect("clicked", lambda b: self.run_cmd("aero-wifi || nm-connection-editor || alacritty -e nmtui"))
        grid.attach(self.btn_wifi, 0, 0, 1, 1)

        self.btn_bt = Gtk.Button(label="🎧 Bluetooth\n<span font='9' color='#8b949e'>Ready</span>")
        self.btn_bt.get_child().set_use_markup(True)
        self.btn_bt.get_style_context().add_class("action-tile")
        self.btn_bt.connect("clicked", lambda b: self.run_cmd("blueman-manager || alacritty -e bluetoothctl"))
        grid.attach(self.btn_bt, 1, 0, 1, 1)

        self.btn_autotile = Gtk.Button(label="⚡ Auto-Tiling\n<span font='9' color='#00f2fe'>Golden BSP</span>")
        self.btn_autotile.get_child().set_use_markup(True)
        self.btn_autotile.get_style_context().add_class("action-tile")
        self.btn_autotile.connect("clicked", self.toggle_autotiling)
        grid.attach(self.btn_autotile, 0, 1, 1, 1)

        self.btn_night = Gtk.Button(label="🌙 Night Light\n<span font='9' color='#fbbf24'>4500K Warm</span>")
        self.btn_night.get_child().set_use_markup(True)
        self.btn_night.get_style_context().add_class("action-tile")
        self.btn_night.connect("clicked", lambda b: self.run_cmd("aero display night on && notify-send 'Night Light' '4500K eye protection active'"))
        grid.attach(self.btn_night, 1, 1, 1, 1)

        self.btn_theme = Gtk.Button(label="🎨 Theme OLED\n<span font='9' color='#00f2fe'>Cyber Cyan</span>")
        self.btn_theme.get_child().set_use_markup(True)
        self.btn_theme.get_style_context().add_class("action-tile")
        self.btn_theme.connect("clicked", self.toggle_theme)
        grid.attach(self.btn_theme, 0, 2, 1, 1)

        self.btn_fan = Gtk.Button(label="❄️ Fan Curve\n<span font='9' color='#fbbf24'>Balanced</span>")
        self.btn_fan.get_child().set_use_markup(True)
        self.btn_fan.get_style_context().add_class("action-tile")
        self.btn_fan.connect("clicked", self.toggle_fan)
        grid.attach(self.btn_fan, 1, 2, 1, 1)

        self.btn_zram = Gtk.Button(label="🧠 zRAM Purge\n<span font='9' color='#34d399'>Compact</span>")
        self.btn_zram.get_child().set_use_markup(True)
        self.btn_zram.get_style_context().add_class("action-tile")
        self.btn_zram.connect("clicked", lambda b: self.run_cmd("aero memory --optimize && notify-send 'zRAM Compacted' 'Memory purged successfully'"))
        grid.attach(self.btn_zram, 0, 3, 1, 1)

        self.btn_power = Gtk.Button(label="🔋 80% Battery\n<span font='9' color='#34d399'>Protected</span>")
        self.btn_power.get_child().set_use_markup(True)
        self.btn_power.get_style_context().add_class("action-tile")
        self.btn_power.connect("clicked", lambda b: self.run_cmd("aero power --threshold 80 && notify-send 'Battery Guard' '80% threshold applied'"))
        grid.attach(self.btn_power, 1, 3, 1, 1)

        vbox.pack_start(grid, False, False, 0)

        # Volume Slider Section
        lbl_vol = Gtk.Label(label="VOLUME")
        lbl_vol.get_style_context().add_class("section-header")
        lbl_vol.set_xalign(0)
        vbox.pack_start(lbl_vol, False, False, 0)

        vol_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        icon_vol = Gtk.Label()
        icon_vol.set_markup("<span font='12'>🔊</span>")
        vol_box.pack_start(icon_vol, False, False, 0)

        self.scale_vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        self.scale_vol.set_value(65)
        self.scale_vol.connect("value-changed", self.on_volume_change)
        vol_box.pack_start(self.scale_vol, True, True, 0)
        vbox.pack_start(vol_box, False, False, 0)

        # Brightness Slider Section
        lbl_bright = Gtk.Label(label="BRIGHTNESS")
        lbl_bright.get_style_context().add_class("section-header")
        lbl_bright.set_xalign(0)
        vbox.pack_start(lbl_bright, False, False, 0)

        bright_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        icon_bright = Gtk.Label()
        icon_bright.set_markup("<span font='12'>☀️</span>")
        bright_box.pack_start(icon_bright, False, False, 0)

        self.scale_bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 100, 5)
        self.scale_bright.set_value(80)
        self.scale_bright.connect("value-changed", self.on_brightness_change)
        bright_box.pack_start(self.scale_bright, True, True, 0)
        vbox.pack_start(bright_box, False, False, 0)

        # Footer Status & Control Center Launcher
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_footer = Gtk.Label()
        lbl_footer.set_markup("<span font='10' color='#8b949e'>Aero Linux 1.1-Edge</span>")
        footer.pack_start(lbl_footer, False, False, 0)

        btn_full_ctrl = Gtk.Button(label="⚙️ All Settings")
        btn_full_ctrl.get_style_context().add_class("action-tile")
        btn_full_ctrl.connect("clicked", lambda b: (self.run_cmd("aero-welcome"), self.destroy()))
        footer.pack_end(btn_full_ctrl, False, False, 0)
        vbox.pack_start(footer, False, False, 0)

        # Connect Escape key to close
        self.connect("key-press-event", self.on_key_press)

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()

    def run_cmd(self, cmd: str):
        subprocess.Popen(cmd, shell=True)

    def toggle_autotiling(self, button):
        self.run_cmd("aero autotile start && notify-send 'Auto-Tiling' 'Dynamic Golden-Ratio window tiling active'")
        button.get_child().set_markup("⚡ Auto-Tiling\n<span font='9' color='#34d399'>Active</span>")

    def toggle_theme(self, button):
        self.run_cmd("aero theme set tokyo-night || aero theme set cyber-cyan")
        button.get_child().set_markup("🌙 Dark\n<span font='9' color='#bb9af7'>Tokyo Night</span>")

    def toggle_fan(self, button):
        self.run_cmd("aero fan set turbo")
        button.get_child().set_markup("❄️ Fan Curve\n<span font='9' color='#00f2fe'>Turbo Max</span>")

    def on_volume_change(self, scale):
        val = int(scale.get_value())
        self.run_cmd(f"pactl set-sink-volume @DEFAULT_SINK@ {val}% 2>/dev/null || wpctl set-volume @DEFAULT_AUDIO_SINK@ {val/100:.2f} 2>/dev/null")

    def on_brightness_change(self, scale):
        val = int(scale.get_value())
        self.run_cmd(f"brightnessctl set {val}% 2>/dev/null")


def main():
    win = QuickSettingsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
