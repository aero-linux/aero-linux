#!/usr/bin/env python3
"""
Aero Linux - Graphical System Restore & Snapshot Manager (Aero TimeMachine)
1-click system restore points, rollback, and storage management.
"""

import os
import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


class SnapshotManagerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero System Restore & TimeMachine")
        self.set_default_size(560, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Cyber Dark Styling
        css = b"""
        window { background-color: #0a0b10; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #12141c; border-radius: 8px; padding: 12px; border: 1px solid #1e293b; }
        .btn-create { background-color: #00f2fe; color: #000000; font-weight: bold; border-radius: 6px; padding: 8px 16px; }
        .btn-create:hover { background-color: #4facfe; }
        .btn-restore { background-color: #f59e0b; color: #000000; font-weight: bold; border-radius: 6px; padding: 4px 10px; }
        .btn-delete { background-color: #ef4444; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 4px 10px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>🛡️ System Restore & TimeMachine</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#94a3b8' font='10'>Create zero-risk system snapshots before updates or configuration changes</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        btn_new = Gtk.Button(label="+ Create Snapshot")
        btn_new.get_style_context().add_class("btn-create")
        btn_new.connect("clicked", lambda b: self.prompt_new_snapshot())
        header_box.pack_start(btn_new, False, False, 0)
        vbox.pack_start(header_box, False, False, 0)

        # Snapshot List
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_min_content_height(340)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.get_style_context().add_class("card")
        scrolled.add(self.listbox)
        vbox.pack_start(scrolled, True, True, 0)

        # Status
        self.lbl_status = Gtk.Label(label="Ready", xalign=0)
        self.lbl_status.set_markup("<span color='#34d399' font='10'>Ready</span>")
        vbox.pack_start(self.lbl_status, False, False, 0)

        self.refresh_snapshots()

    def refresh_snapshots(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        # Check snapshot directory
        snap_dir = os.path.expanduser("~/.config/aero/snapshots")
        snapshots = []
        if os.path.exists(snap_dir):
            for item in sorted(os.listdir(snap_dir), reverse=True):
                snapshots.append(item)

        if not snapshots:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="No snapshots created yet. Click '+ Create Snapshot' above.", xalign=0)
            lbl.set_margin_top(20)
            lbl.set_margin_bottom(20)
            row.add(lbl)
            self.listbox.add(row)
        else:
            for s in snapshots:
                row = Gtk.ListBoxRow()
                hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                hbox.set_margin_top(6)
                hbox.set_margin_bottom(6)
                hbox.set_margin_start(10)
                hbox.set_margin_end(10)

                vbox_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                lbl_name = Gtk.Label(xalign=0)
                lbl_name.set_markup(f"<b>🛡️ {GLib.markup_escape_text(s)}</b>")
                vbox_info.pack_start(lbl_name, False, False, 0)
                hbox.pack_start(vbox_info, True, True, 0)

                btn_rst = Gtk.Button(label="Restore")
                btn_rst.get_style_context().add_class("btn-restore")
                btn_rst.connect("clicked", lambda b, name=s: self.restore_snapshot(name))
                hbox.pack_start(btn_rst, False, False, 0)

                row.add(hbox)
                self.listbox.add(row)

        self.listbox.show_all()

    def prompt_new_snapshot(self):
        dialog = Gtk.Dialog(title="Create System Restore Point", parent=self, flags=0)
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, "Create", Gtk.ResponseType.OK)
        dialog.set_default_size(300, 130)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_margin_top(12)

        lbl = Gtk.Label(label="Snapshot Label / Description:", xalign=0)
        entry = Gtk.Entry()
        entry.set_text("Pre-Update-Restore-Point")
        box.add(lbl)
        box.add(entry)
        dialog.show_all()

        resp = dialog.run()
        name = entry.get_text()
        dialog.destroy()

        if resp == Gtk.ResponseType.OK:
            self.lbl_status.set_markup("<span color='#00f2fe' font='10'>Creating snapshot...</span>")
            threading.Thread(target=self._create_worker, args=(name,), daemon=True).start()

    def _create_worker(self, name):
        subprocess.run(["aero", "snapshot", "create", name], capture_output=True)
        GLib.idle_add(self._on_created, name)

    def _on_created(self, name):
        subprocess.run(["notify-send", "🛡️ Snapshot Created", f"Restore point '{name}' is ready."])
        self.refresh_snapshots()
        self.lbl_status.set_markup("<span color='#34d399' font='10'>Snapshot created successfully.</span>")

    def restore_snapshot(self, name):
        confirm = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=f"Restore system state to '{name}'?"
        )
        confirm.format_secondary_text("This will rollback configurations to this point in time.")
        resp = confirm.run()
        confirm.destroy()

        if resp == Gtk.ResponseType.OK:
            subprocess.run(["aero", "snapshot", "restore", name], capture_output=True)
            subprocess.run(["notify-send", "🛡️ System Restored", f"Restored snapshot '{name}'."])
            self.lbl_status.set_markup(f"<span color='#34d399' font='10'>System restored to '{name}'.</span>")


def main():
    win = SnapshotManagerWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
