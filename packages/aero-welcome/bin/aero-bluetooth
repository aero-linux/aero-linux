#!/usr/bin/env python3
"""
Aero Linux - Graphical Bluetooth Manager & Pairing Center
Visual Bluetooth device scanner, audio device pairing, and peripheral connection center.
"""

import os
import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


class BluetoothManagerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Bluetooth & Peripheral Center")
        self.set_default_size(520, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Cyber Dark Styling
        css = b"""
        window { background-color: #0a0b10; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #12141c; border-radius: 8px; padding: 12px; border: 1px solid #1e293b; }
        .btn-pair { background-color: #00f2fe; color: #000000; font-weight: bold; border-radius: 6px; padding: 6px 14px; }
        .btn-pair:hover { background-color: #4facfe; }
        .btn-disconnect { background-color: #ef4444; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 6px 12px; }
        .btn-refresh { background-color: #1e293b; color: #f8fafc; border-radius: 6px; padding: 6px 12px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>🎧 Bluetooth & Devices</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#94a3b8' font='10'>Pair headphones, earbuds, keyboards, mice, and game controllers</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        self.btn_scan = Gtk.Button(label="🔄 Scan Devices")
        self.btn_scan.get_style_context().add_class("btn-refresh")
        self.btn_scan.connect("clicked", lambda b: self.start_scan())
        header_box.pack_start(self.btn_scan, False, False, 0)
        vbox.pack_start(header_box, False, False, 0)

        # Device List
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_min_content_height(380)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.get_style_context().add_class("card")
        scrolled.add(self.listbox)
        vbox.pack_start(scrolled, True, True, 0)

        # Status Bar
        self.lbl_status = Gtk.Label(label="Ready", xalign=0)
        self.lbl_status.set_markup("<span color='#94a3b8' font='10'>Ready</span>")
        vbox.pack_start(self.lbl_status, False, False, 0)

        self.start_scan()

    def start_scan(self):
        self.btn_scan.set_sensitive(False)
        self.lbl_status.set_markup("<span color='#00f2fe' font='10'>Scanning for Bluetooth devices...</span>")
        threading.Thread(target=self._scan_worker, daemon=True).start()

    def _scan_worker(self):
        devices = []
        try:
            # Query paired & discovered devices
            res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True, timeout=5)
            paired_res = subprocess.run(["bluetoothctl", "paired-devices"], capture_output=True, text=True, timeout=5)
            paired_macs = set()
            for line in paired_res.stdout.splitlines():
                parts = line.split(" ", 2)
                if len(parts) >= 2:
                    paired_macs.add(parts[1].strip())

            for line in res.stdout.splitlines():
                parts = line.split(" ", 2)
                if len(parts) >= 3:
                    mac = parts[1].strip()
                    name = parts[2].strip()
                    is_paired = mac in paired_macs
                    devices.append({
                        "mac": mac,
                        "name": name,
                        "paired": is_paired
                    })
        except Exception:
            pass

        GLib.idle_add(self._update_ui, devices)

    def _update_ui(self, devices):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        if not devices:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="No Bluetooth devices found. Put device in pairing mode and click 'Scan'.", xalign=0)
            lbl.set_margin_top(20)
            lbl.set_margin_bottom(20)
            row.add(lbl)
            self.listbox.add(row)
        else:
            for dev in devices:
                row = Gtk.ListBoxRow()
                hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                hbox.set_margin_top(8)
                hbox.set_margin_bottom(8)
                hbox.set_margin_start(10)
                hbox.set_margin_end(10)

                vbox_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                lbl_name = Gtk.Label(xalign=0)
                tag = " <span color='#34d399' font='9'>[Paired]</span>" if dev["paired"] else ""
                lbl_name.set_markup(f"<b>{GLib.markup_escape_text(dev['name'])}</b>{tag}")
                
                lbl_mac = Gtk.Label(xalign=0)
                lbl_mac.set_markup(f"<span color='#64748b' font='9'>{dev['mac']}</span>")
                
                vbox_info.pack_start(lbl_name, False, False, 0)
                vbox_info.pack_start(lbl_mac, False, False, 0)
                hbox.pack_start(vbox_info, True, True, 0)

                if dev["paired"]:
                    btn_conn = Gtk.Button(label="Connect")
                    btn_conn.get_style_context().add_class("btn-pair")
                    btn_conn.connect("clicked", lambda b, m=dev["mac"], n=dev["name"]: self._connect_device(m, n))
                    hbox.pack_start(btn_conn, False, False, 0)

                    btn_rem = Gtk.Button(label="Remove")
                    btn_rem.get_style_context().add_class("btn-disconnect")
                    btn_rem.connect("clicked", lambda b, m=dev["mac"]: self._remove_device(m))
                    hbox.pack_start(btn_rem, False, False, 0)
                else:
                    btn_pair = Gtk.Button(label="Pair")
                    btn_pair.get_style_context().add_class("btn-pair")
                    btn_pair.connect("clicked", lambda b, m=dev["mac"], n=dev["name"]: self._pair_device(m, n))
                    hbox.pack_start(btn_pair, False, False, 0)

                row.add(hbox)
                self.listbox.add(row)

        self.listbox.show_all()
        self.btn_scan.set_sensitive(True)
        self.lbl_status.set_markup(f"<span color='#34d399' font='10'>Scan completed. Found {len(devices)} devices.</span>")

    def _pair_device(self, mac, name):
        self.lbl_status.set_markup(f"<span color='#00f2fe' font='10'>Pairing with {name}...</span>")
        threading.Thread(target=self._pair_worker, args=(mac, name), daemon=True).start()

    def _pair_worker(self, mac, name):
        subprocess.run(["bluetoothctl", "pair", mac], capture_output=True)
        subprocess.run(["bluetoothctl", "trust", mac], capture_output=True)
        subprocess.run(["bluetoothctl", "connect", mac], capture_output=True)
        GLib.idle_add(self._on_paired, name)

    def _on_paired(self, name):
        subprocess.run(["notify-send", "🎧 Bluetooth Paired", f"Successfully connected to {name}"])
        self.start_scan()

    def _connect_device(self, mac, name):
        self.lbl_status.set_markup(f"<span color='#00f2fe' font='10'>Connecting to {name}...</span>")
        threading.Thread(target=lambda: subprocess.run(["bluetoothctl", "connect", mac]), daemon=True).start()

    def _remove_device(self, mac):
        subprocess.run(["bluetoothctl", "remove", mac], capture_output=True)
        self.start_scan()


def main():
    win = BluetoothManagerWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
