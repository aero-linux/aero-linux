#!/usr/bin/env python3
"""
Aero Linux - Graphical Developer Scratchpad & Sticky Notes Studio
Lightweight persistent floating notes, code scratchpad, and auto-saving Markdown editor.
"""

import os
import shutil
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


NOTES_PATH = os.path.expanduser("~/.config/aero/notes.md")


class NotesWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Developer Scratchpad")
        self.set_default_size(460, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(12)

        # Styling
        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'JetBrains Mono', 'Fira Code', monospace; }
        .header-title { font-size: 16px; font-weight: bold; color: #fbbf24; font-family: 'Inter', sans-serif; }
        .card { background-color: #111827; border-radius: 8px; padding: 6px; border: 1px solid #1f2937; }
        textview text { background-color: #0d1117; color: #f0f6fc; font-size: 13px; font-family: 'JetBrains Mono', monospace; }
        .btn-action { background-color: #1e293b; color: #f8fafc; border-radius: 6px; padding: 6px 12px; font-size: 11px; font-weight: bold; font-family: 'Inter', sans-serif; }
        .btn-action:hover { background-color: #334155; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>📝 Aero Scratchpad</span>")
        header_box.pack_start(lbl_title, True, True, 0)

        # Pin & Action buttons
        self.btn_pin = Gtk.Button(label="📌 Pin on Top")
        self.btn_pin.get_style_context().add_class("btn-action")
        self.btn_pin.connect("clicked", self._toggle_keep_above)
        header_box.pack_start(self.btn_pin, False, False, 0)

        btn_copy = Gtk.Button(label="📋 Copy All")
        btn_copy.get_style_context().add_class("btn-action")
        btn_copy.connect("clicked", self._on_copy)
        header_box.pack_start(btn_copy, False, False, 0)

        btn_clear = Gtk.Button(label="🗑️ Clear")
        btn_clear.get_style_context().add_class("btn-action")
        btn_clear.connect("clicked", self._on_clear)
        header_box.pack_start(btn_clear, False, False, 0)

        vbox.pack_start(header_box, False, False, 0)

        # Editor View
        scrolled = Gtk.ScrolledWindow()
        scrolled.get_style_context().add_class("card")
        
        self.text_view = Gtk.TextView()
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.text_view.set_left_margin(10)
        self.text_view.set_right_margin(10)
        self.text_view.set_top_margin(10)
        self.text_view.set_bottom_margin(10)
        self.buffer = self.text_view.get_buffer()
        self.buffer.connect("changed", self._on_text_changed)

        scrolled.add(self.text_view)
        vbox.pack_start(scrolled, True, True, 0)

        # Status
        self.lbl_status = Gtk.Label(label="Auto-saved to ~/.config/aero/notes.md", xalign=0)
        self.lbl_status.set_markup("<span color='#94a3b8' font='9'>Auto-saved to ~/.config/aero/notes.md</span>")
        vbox.pack_start(self.lbl_status, False, False, 0)

        self._load_notes()

    def _toggle_keep_above(self, button):
        is_above = getattr(self, "_is_pinned", False)
        self.set_keep_above(not is_above)
        self._is_pinned = not is_above
        self.btn_pin.set_label("📍 Pinned" if self._is_pinned else "📌 Pin on Top")

    def _load_notes(self):
        if os.path.exists(NOTES_PATH):
            try:
                with open(NOTES_PATH, "r", encoding="utf-8") as f:
                    content = f.read()
                self.buffer.set_text(content)
            except Exception:
                pass
        else:
            default_txt = "# Aero Developer Scratchpad\n- [ ] Task 1\n- [ ] Task 2\n\n```python\n# Quick snippet\nprint('Hello Aero!')\n```\n"
            self.buffer.set_text(default_txt)

    def _on_text_changed(self, buffer):
        start, end = buffer.get_bounds()
        text = buffer.get_text(start, end, True)
        os.makedirs(os.path.dirname(NOTES_PATH), exist_ok=True)
        try:
            with open(NOTES_PATH, "w", encoding="utf-8") as f:
                f.write(text)
            self.lbl_status.set_markup("<span color='#34d399' font='9'>Saved to ~/.config/aero/notes.md</span>")
        except Exception as e:
            self.lbl_status.set_markup(f"<span color='#f43f5e' font='9'>Save error: {e}</span>")

    def _on_copy(self, button):
        start, end = self.buffer.get_bounds()
        text = self.buffer.get_text(start, end, True)
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_text(text, -1)
        self.lbl_status.set_markup("<span color='#34d399' font='9'>Copied all notes to clipboard!</span>")
        subprocess.run(["notify-send", "📝 Scratchpad", "All notes copied to clipboard"])

    def _on_clear(self, button):
        self.buffer.set_text("")
        self.lbl_status.set_markup("<span color='#f43f5e' font='9'>Scratchpad cleared.</span>")


def main():
    win = NotesWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
