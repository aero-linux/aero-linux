#!/usr/bin/env python3
"""
Aero Linux - Graphical Update Manager
Visual system & package upgrade manager with categorization and progress indicators.
"""

import os
import subprocess
import threading
from typing import List, Dict, Any

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib


CSS = b"""
window {
    background-color: #0d1117;
    color: #f0f6fc;
}

.update-card {
    background: #161b22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px;
}

button.primary-btn {
    background: linear-gradient(135deg, #00f2fe, #4facfe);
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    color: #0a0b0e;
    font-weight: 800;
    font-size: 13px;
}

button.primary-btn:hover {
    background: linear-gradient(135deg, #38ef7d, #11998e);
}

progressbar trough {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    min-height: 12px;
}

progressbar progress {
    background: linear-gradient(90deg, #38ef7d, #11998e);
    border-radius: 6px;
}

treeview {
    background-color: #161b22;
    color: #f0f6fc;
    border-radius: 8px;
}
"""


def fetch_upgradable_packages() -> List[Dict[str, Any]]:
    packages = []
    try:
        out = subprocess.check_output(
            ["apt", "list", "--upgradable"],
            text=True,
            stderr=subprocess.DEVNULL
        )
        for line in out.splitlines()[1:]:
            if "/" in line and "[" in line:
                name_part = line.split("/")[0]
                version_part = line.split()[1]
                category = "Application Update"
                if "linux-image" in name_part or "linux-headers" in name_part:
                    category = "Kernel Security"
                elif "lib" in name_part or "systemd" in name_part:
                    category = "Core System Library"

                packages.append({
                    "name": name_part,
                    "version": version_part,
                    "category": category,
                })
    except Exception:
        pass
    return packages


class UpdateManagerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Update Manager")
        self.set_default_size(720, 520)
        self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        vbox.set_margin_top(18)
        vbox.set_margin_bottom(18)
        vbox.set_margin_start(18)
        vbox.set_margin_end(18)
        self.add(vbox)

        # Header Title & Refresh
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl_title = Gtk.Label()
        lbl_title.set_markup("<span font='14' weight='bold' color='#00f2fe'>🔄 Aero Update Manager</span>")
        header.pack_start(lbl_title, False, False, 0)

        btn_refresh = Gtk.Button(label="🔄 Check Again")
        btn_refresh.connect("clicked", lambda b: self.load_updates())
        header.pack_end(btn_refresh, False, False, 0)
        vbox.pack_start(header, False, False, 0)

        # Status Summary Card
        self.card_status = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.card_status.get_style_context().add_class("update-card")
        self.lbl_status = Gtk.Label()
        self.lbl_status.set_markup("<b>Scanning for system, kernel & security updates...</b>")
        self.lbl_status.set_xalign(0)
        self.card_status.pack_start(self.lbl_status, False, False, 0)

        self.pb_update = Gtk.ProgressBar()
        self.pb_update.set_fraction(0.0)
        self.card_status.pack_start(self.pb_update, False, False, 0)
        vbox.pack_start(self.card_status, False, False, 0)

        # Upgradable Packages List
        self.liststore = Gtk.ListStore(str, str, str)
        self.treeview = Gtk.TreeView(model=self.liststore)

        cols = [
            ("Package Name", 0, 260),
            ("New Version", 1, 180),
            ("Category", 2, 180),
        ]
        for title, col_id, width in cols:
            renderer = Gtk.CellRendererText()
            col = Gtk.TreeViewColumn(title, renderer, text=col_id)
            col.set_fixed_width(width)
            self.treeview.append_column(col)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.treeview)
        vbox.pack_start(scroll, True, True, 0)

        # Footer Actions
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.lbl_footer_info = Gtk.Label()
        self.lbl_footer_info.set_markup("<span font='10' color='#8b949e'>Aero Linux Rolling Edge</span>")
        footer.pack_start(self.lbl_footer_info, False, False, 0)

        self.btn_install = Gtk.Button(label="⚡ Install Updates")
        self.btn_install.get_style_context().add_class("primary-btn")
        self.btn_install.connect("clicked", self.on_install_clicked)
        footer.pack_end(self.btn_install, False, False, 0)
        vbox.pack_start(footer, False, False, 0)

        # Initial Load
        GLib.idle_add(self.load_updates)

    def load_updates(self):
        self.liststore.clear()
        pkgs = fetch_upgradable_packages()
        if not pkgs:
            self.lbl_status.set_markup("<b><span color='#34d399'>✔ Your system is fully up to date!</span></b>")
            self.btn_install.set_sensitive(False)
        else:
            self.lbl_status.set_markup(f"<b><span color='#00f2fe'>{len(pkgs)} Update(s) Available</span> (Security & Software)</b>")
            self.btn_install.set_sensitive(True)
            for p in pkgs:
                self.liststore.append([p["name"], p["version"], p["category"]])

    def on_install_clicked(self, button):
        self.btn_install.set_sensitive(False)
        self.lbl_status.set_markup("<b>⚡ Applying updates via APT...</b>")
        self.pb_update.pulse()

        def run_upgrade():
            subprocess.run(["pkexec", "apt-get", "upgrade", "-y"])
            GLib.idle_add(self.on_upgrade_complete)

        threading.Thread(target=run_upgrade, daemon=True).start()

    def on_upgrade_complete(self):
        self.pb_update.set_fraction(1.0)
        self.lbl_status.set_markup("<b><span color='#34d399'>✔ All updates applied successfully!</span></b>")
        subprocess.run(["notify-send", "Update Complete", "All system packages are up to date."])
        self.load_updates()


def main():
    win = UpdateManagerWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
