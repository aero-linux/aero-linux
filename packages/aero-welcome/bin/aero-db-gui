#!/usr/bin/env python3
"""
Aero Linux - Database & Query Studio (GTK3)
Native SQLite/database explorer, interactive SQL query editor, table visualizer, and CSV/JSON exporter.
"""

import csv
import gi
import json
import os
import sqlite3
import sys
import time

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

