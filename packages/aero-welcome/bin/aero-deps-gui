#!/usr/bin/env python3
"""
Aero Linux - System Packages & Binary Dependencies Studio (GTK3)
Visual package inspector, shared library analyzer (ldd), and orphaned package cleaner.
"""

import gi
import os
import shutil
import subprocess
import sys
import threading

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

