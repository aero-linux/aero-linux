#!/usr/bin/env python3
"""
Aero Linux - Docker & Container Orchestration Studio (GTK3)
1-Click container management, live status telemetry, and container logs viewer.
"""

import gi
import os
import sys
import threading

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

# Setup PYTHONPATH for aero modules
CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
CLI_DIR = os.path.abspath(os.path.join(CURRENT_DIR, "../../aero-cli"))
if CLI_DIR not in sys.path:
    sys.path.insert(0, CLI_DIR)

from aero.docker_tools import check_docker, get_containers_list, container_action, get_container_logs, prune_docker


CSS_STYLING = b"""
* {
    font-family: 'Inter', 'Ubuntu', 'Segoe UI', sans-serif;
}
window {
    background-color: #050811;
    color: #e2e8f0;
}
.header-box {
    background: linear-gradient(135deg, #0b1329 0%, #050811 100%);
    border-bottom: 1px solid rgba(0, 242, 254, 0.25);
    padding: 16px 20px;
}
.header-title {
    font-size: 16pt;
    font-weight: 800;
    color: #ffffff;
}
.header-desc {
    font-size: 9pt;
