    padding: 6px 12px;
    font-weight: 700;
}
.btn-danger:hover {
    background-color: #ef4444;
    color: #ffffff;
}
.logs-view {
    background-color: #050811;
    color: #38bdf8;
    font-family: 'JetBrains Mono', 'Fira Code', 'Monospace';
    font-size: 9pt;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 10px;
}
