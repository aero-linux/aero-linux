#!/usr/bin/env python3
"""
Aero Linux - Graphical Display & Multi-Monitor Manager
Visual resolution, high-refresh rate (144Hz/165Hz/240Hz), and fractional scaling control.
"""

import json
import os
import shutil
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


class DisplayManagerWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Displays & Resolution Manager")
        self.set_default_size(520, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Cyber Dark Styling
        css = b"""
        window { background-color: #0a0b10; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #12141c; border-radius: 8px; padding: 14px; border: 1px solid #1e293b; }
        .btn-apply { background-color: #00f2fe; color: #000000; font-weight: bold; border-radius: 6px; padding: 8px 18px; }
        .btn-apply:hover { background-color: #4facfe; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>🖥️ Displays & Multi-Monitor</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#94a3b8' font='10'>Configure resolution, high refresh rates (144Hz+), and HiDPI scaling</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)
        vbox.pack_start(header_box, False, False, 0)

        # Settings Card
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class("card")

        # 1. Resolution
        lbl_res = Gtk.Label(label="Display Resolution:", xalign=0)
        self.combo_res = Gtk.ComboBoxText()
        self.combo_res.append("1920x1080", "1920x1080 (FHD 16:9)")
        self.combo_res.append("2560x1440", "2560x1440 (2K QHD 16:9)")
        self.combo_res.append("3840x2160", "3840x2160 (4K UHD 16:9)")
        self.combo_res.append("1920x1200", "1920x1200 (16:10 Laptop)")
        self.combo_res.set_active(0)
        card.pack_start(lbl_res, False, False, 0)
        card.pack_start(self.combo_res, False, False, 0)

        # 2. Refresh Rate
        lbl_hz = Gtk.Label(label="Refresh Rate (Hz):", xalign=0)
        self.combo_hz = Gtk.ComboBoxText()
        self.combo_hz.append("60", "60 Hz (Standard / Battery Saver)")
        self.combo_hz.append("120", "120 Hz (Smooth)")
        self.combo_hz.append("144", "144 Hz (Gaming & Pro Motion)")
        self.combo_hz.append("165", "165 Hz (Ultra Smooth)")
        self.combo_hz.append("240", "240 Hz (Competitive Esports)")
        self.combo_hz.set_active(0)
        card.pack_start(lbl_hz, False, False, 0)
        card.pack_start(self.combo_hz, False, False, 0)

        # 3. Fractional Scale
        lbl_scale = Gtk.Label(label="HiDPI Fractional UI Scaling:", xalign=0)
        self.combo_scale = Gtk.ComboBoxText()
        self.combo_scale.append("1.0", "100% (Native Pixel-Perfect)")
        self.combo_scale.append("1.25", "125% (Recommended for 14\"-15\" FHD/2K)")
        self.combo_scale.append("1.5", "150% (Comfortable Large Text)")
        self.combo_scale.append("2.0", "200% (4K Retina Scaling)")
        self.combo_scale.set_active(0)
        card.pack_start(lbl_scale, False, False, 0)
        card.pack_start(self.combo_scale, False, False, 0)

        vbox.pack_start(card, True, True, 0)

        # Actions
        btn_apply = Gtk.Button(label="⚡ Apply Display Configuration")
        btn_apply.get_style_context().add_class("btn-apply")
        btn_apply.connect("clicked", self._apply_settings)
        vbox.pack_start(btn_apply, False, False, 0)

    def _apply_settings(self, button):
        res = self.combo_res.get_active_id()
        hz = self.combo_hz.get_active_id()
        scale = self.combo_scale.get_active_id()

        if shutil.which("swaymsg"):
            subprocess.run(
                ["swaymsg", f"output * mode {res}@{hz}Hz scale {scale}"],
                capture_output=True
            )
            subprocess.run(
                ["swaymsg", f"output * scale {scale}"],
                capture_output=True
            )

        subprocess.run([
            "notify-send",
            "🖥️ Display Updated",
            f"Set to {res} @ {hz}Hz with {int(float(scale)*100)}% scale."
        ])


def main():
    win = DisplayManagerWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
