#!/usr/bin/env python3
"""
Aero Linux - Cron & Scheduled Tasks Studio (GTK3)
Visual scheduled tasks manager, human-readable cron builder, 1-click test runner, and system maintenance scheduler.
"""

import gi
import os
import subprocess
import sys
import threading

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

# Setup PYTHONPATH for aero modules
CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
CLI_DIR = os.path.abspath(os.path.join(CURRENT_DIR, "../../aero-cli"))
if CLI_DIR not in sys.path:
    sys.path.insert(0, CLI_DIR)

from aero.cron_mgr import get_cron_jobs, add_cron_job, delete_cron_job, toggle_cron_job, humanize_cron, enable_auto_maintenance

CSS_STYLING = b"""
* {
    font-family: 'Inter', 'Ubuntu', 'Segoe UI', sans-serif;
}
window {
    background-color: #050811;
    color: #e2e8f0;
}
.header-box {
    background: linear-gradient(135deg, #0b1329 0%, #050811 100%);
    border-bottom: 1px solid rgba(0, 242, 254, 0.25);
    padding: 16px 20px;
}
.header-title {
    font-size: 16pt;
    font-weight: 800;
    color: #ffffff;
