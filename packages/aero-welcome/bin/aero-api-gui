#!/usr/bin/env python3
"""
Aero Linux - Native API & HTTP Studio (GTK3)
Ultra-fast, zero-overhead REST/HTTP client for testing endpoints, microservices, and webhooks.
"""

import gi
import json
import os
import sys
import threading
import time
import urllib.parse
import urllib.request
import urllib.error

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

