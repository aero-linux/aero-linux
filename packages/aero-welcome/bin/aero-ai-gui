#!/usr/bin/env python3
"""
Aero Linux - Graphical Local AI & LLM Model Studio
1-click local LLM serving, Ollama model manager, VRAM estimator, and offline coding AI assistant.
"""

import json
import os
import shutil
import subprocess
import threading
import urllib.request
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

MODELS_CATALOG = [
    {"name": "qwen2.5-coder:7b", "desc": "Top-tier coding LLM for Python, TypeScript & C", "vram": "4.8 GB", "quant": "Q4_K_M"},
    {"name": "deepseek-r1:8b", "desc": "State-of-the-art reasoning & mathematical logic", "vram": "5.2 GB", "quant": "Q4_K_M"},
    {"name": "llama3.2:3b", "desc": "Ultra-fast lightweight edge assistant (<3GB RAM)", "vram": "2.4 GB", "quant": "Q4_K_M"},
    {"name": "codellama:7b", "desc": "Meta specialized code completion model", "vram": "4.8 GB", "quant": "Q4_K_M"},
    {"name": "phi3.5:3.8b", "desc": "Microsoft dense reasoning and instruction model", "vram": "2.6 GB", "quant": "Q4_K_M"},
    {"name": "nomic-embed-text", "desc": "Local vector embeddings for RAG & codebase search", "vram": "0.6 GB", "quant": "F16"},
]


def check_ollama_status():
    try:
        req = urllib.request.Request("http://127.0.0.1:11434/api/tags", headers={"User-Agent": "Aero-AI/1.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            installed_models = [m.get("name") for m in data.get("models", [])]
            return {"running": True, "installed": installed_models}
    except Exception:
        return {"running": False, "installed": []}


class LocalAIStudioWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Local AI & LLM Studio")
        self.set_default_size(780, 580)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Styling
        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #10b981; }
        .card { background-color: #111827; border-radius: 10px; padding: 12px 16px; border: 1px solid #1f2937; }
        .btn-pull { background-color: #059669; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 4px 12px; font-size: 11px; }
        .btn-pull:hover { background-color: #10b981; }
        .btn-run { background-color: #3b82f6; color: #ffffff; font-weight: bold; border-radius: 6px; padding: 4px 12px; font-size: 11px; }
        .btn-start { background-color: #10b981; color: #000000; font-weight: bold; border-radius: 6px; padding: 6px 14px; font-size: 12px; }
        .chat-view { background-color: #030712; color: #e2e8f0; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>🤖 Aero Local AI &amp; LLM Studio</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#9ca3af' font='10'>1-click offline AI serving, Ollama model puller, VRAM optimizer &amp; code assistant</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        self.btn_daemon = Gtk.Button(label="⚡ Start Ollama")
        self.btn_daemon.get_style_context().add_class("btn-start")
        self.btn_daemon.connect("clicked", self._toggle_daemon)
        header_box.pack_start(self.btn_daemon, False, False, 0)

        vbox.pack_start(header_box, False, False, 0)

        # Notebook tabs
        notebook = Gtk.Notebook()
        vbox.pack_start(notebook, True, True, 0)

        # Tab 1: Models Catalog
        tab_models = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        tab_models.set_border_width(10)
        scrolled_models = Gtk.ScrolledWindow()
        self.models_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scrolled_models.add(self.models_box)
        tab_models.pack_start(scrolled_models, True, True, 0)
        notebook.append_page(tab_models, Gtk.Label(label="📦 Model Catalog & VRAM"))

        # Tab 2: Interactive Prompt / Playground
        tab_play = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        tab_play.set_border_width(10)

        self.chat_view = Gtk.TextView()
        self.chat_view.get_style_context().add_class("chat-view")
        self.chat_view.set_editable(False)
        self.chat_view.set_wrap_mode(Gtk.WrapMode.WORD)
        scrolled_chat = Gtk.ScrolledWindow()
        scrolled_chat.add(self.chat_view)
        tab_play.pack_start(scrolled_chat, True, True, 0)

        # Input box
        input_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry_prompt = Gtk.Entry()
        self.entry_prompt.set_placeholder_text("Ask a coding question or generate a function...")
        self.entry_prompt.connect("activate", self._on_send_prompt)
        input_box.pack_start(self.entry_prompt, True, True, 0)

        btn_send = Gtk.Button(label="Send ➔")
        btn_send.get_style_context().add_class("btn-start")
        btn_send.connect("clicked", self._on_send_prompt)
        input_box.pack_start(btn_send, False, False, 0)

        tab_play.pack_start(input_box, False, False, 0)
        notebook.append_page(tab_play, Gtk.Label(label="💬 Local AI Playground"))

        # Status Bar
        self.lbl_status = Gtk.Label(label="Checking local AI engine...", xalign=0)
        vbox.pack_start(self.lbl_status, False, False, 0)

        self._refresh_status()

    def _refresh_status(self):
        def run():
            status = check_ollama_status()
            GLib.idle_add(self._display_status, status)

        threading.Thread(target=run, daemon=True).start()

    def _display_status(self, status):
        is_running = status["running"]
        installed = status["installed"]

        if is_running:
            self.btn_daemon.set_label("🟢 Ollama Active")
            self.lbl_status.set_markup(f"<span color='#10b981' font='10'>Ollama Daemon: <b>ONLINE</b> — {len(installed)} local model(s) cached</span>")
        else:
            self.btn_daemon.set_label("⚡ Start Ollama")
            self.lbl_status.set_markup("<span color='#f59e0b' font='10'>Ollama Daemon: <b>OFFLINE</b> (Click 'Start Ollama' to launch local inference server)</span>")

        # Re-populate catalog
        for child in self.models_box.get_children():
            self.models_box.remove(child)

        for m in MODELS_CATALOG:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.get_style_context().add_class("card")

            is_inst = any(m["name"] in inst for inst in installed)

            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl_n = Gtk.Label(xalign=0)
            status_tag = "<span color='#10b981' font='9'>[CACHED]</span>" if is_inst else "<span color='#9ca3af' font='9'>[READY TO PULL]</span>"
            lbl_n.set_markup(f"<b>{m['name']}</b> {status_tag} <span color='#38bdf8' font='9'>({m['quant']})</span>")
            
            lbl_d = Gtk.Label(xalign=0)
            lbl_d.set_markup(f"<span color='#9ca3af' font='9'>{m['desc']} — Required VRAM: <b>{m['vram']}</b></span>")
            info.pack_start(lbl_n, False, False, 0)
            info.pack_start(lbl_d, False, False, 0)
            row.pack_start(info, True, True, 0)

            if is_inst:
                btn_run = Gtk.Button(label="▶ Run Terminal")
                btn_run.get_style_context().add_class("btn-run")
                btn_run.connect("clicked", lambda b, name=m['name']: self._launch_terminal_chat(name))
                row.pack_start(btn_run, False, False, 0)
            else:
                btn_pull = Gtk.Button(label="📥 Pull Model")
                btn_pull.get_style_context().add_class("btn-pull")
                btn_pull.connect("clicked", lambda b, name=m['name']: self._pull_model(name))
                row.pack_start(btn_pull, False, False, 0)

            self.models_box.pack_start(row, False, False, 0)

        self.models_box.show_all()

    def _toggle_daemon(self, button):
        subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(1500, self._refresh_status)

    def _pull_model(self, name):
        self.lbl_status.set_markup(f"<span color='#38bdf8' font='10'>📥 Pulling model <b>{name}</b> in background...</span>")
        subprocess.Popen(f"alacritty -e ollama pull {name}", shell=True)

    def _launch_terminal_chat(self, name):
        subprocess.Popen(f"alacritty -e ollama run {name}", shell=True)

    def _on_send_prompt(self, widget):
        prompt = self.entry_prompt.get_text().strip()
        if not prompt:
            return
        self.entry_prompt.set_text("")

        buf = self.chat_view.get_buffer()
        end_iter = buf.get_end_iter()
        buf.insert(end_iter, f"\n🧑 User: {prompt}\n\n🤖 Aero AI: Thinking...\n")

        def run():
            try:
                payload = json.dumps({"model": "qwen2.5-coder:7b", "prompt": prompt, "stream": False}).encode("utf-8")
                req = urllib.request.Request("http://127.0.0.1:11434/api/generate", data=payload, headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=30) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                    response_text = data.get("response", "(No response received)")
            except Exception as e:
                response_text = f"Local inference engine offline. Run 'ollama serve' and pull a model first.\nError: {e}"

            GLib.idle_add(self._append_ai_response, response_text)

        threading.Thread(target=run, daemon=True).start()

    def _append_ai_response(self, text):
        buf = self.chat_view.get_buffer()
        end_iter = buf.get_end_iter()
        buf.insert(end_iter, f"{text}\n" + "─"*50 + "\n")


def main():
    win = LocalAIStudioWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
