#!/usr/bin/env python3
"""
Aero Linux - Regular Expression & Pattern Studio (GTK3)
Real-time regex evaluator, named capture group inspector, syntax validator, and pattern library.
"""

import gi
import re
import sys
import time

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

CSS_STYLING = b"""
