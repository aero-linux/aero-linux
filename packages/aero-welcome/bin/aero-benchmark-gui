    background-color: #243052;
    color: #00f2fe;
}
.code-editor {
    background-color: #080d1a;
    color: #38bdf8;
    font-family: 'JetBrains Mono', 'Fira Code', 'Monospace';
    font-size: 9pt;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 10px;
}
