#!/usr/bin/env python3
"""
Aero Linux - Hardware & Systems Benchmark Studio (GTK3)
Multi-core CPU compute, RAM memory bandwidth, and NVMe disk I/O performance benchmark suite.
"""

import gi
import hashlib
import json
import multiprocessing
import os
import platform
import subprocess
import sys
import tempfile
import threading
import time

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

CSS_STYLING = b"""
* {
    font-family: 'Inter', 'Ubuntu', 'Segoe UI', sans-serif;
}
window {
    background-color: #050811;
    color: #e2e8f0;
}
.header-box {
    background: linear-gradient(135deg, #0b1329 0%, #050811 100%);
    border-bottom: 1px solid rgba(0, 242, 254, 0.25);
    padding: 16px 20px;
}
.header-title {
    font-size: 16pt;
    font-weight: 800;
    color: #ffffff;
}
