#!/usr/bin/env python3
"""
Aero Linux - Graphical Network Speed, Latency & DNS Benchmark Studio
1-click high-precision ping profiler, DNS resolver speed tester, and CDN throughput gauge.
"""

import os
import shutil
import subprocess
import threading
import time
import urllib.request
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


DNS_TARGETS = [
    {"name": "Cloudflare DNS", "server": "1.1.1.1"},
    {"name": "Google Public DNS", "server": "8.8.8.8"},
    {"name": "Quad9 Secure DNS", "server": "9.9.9.9"},
    {"name": "OpenDNS Home", "server": "208.67.222.222"},
]


class SpeedStudioWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Network Speed & Latency Studio")
        self.set_default_size(580, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Styling
        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 18px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #111827; border-radius: 10px; padding: 14px; border: 1px solid #1f2937; }
        .btn-test { background-color: #00f2fe; color: #000000; font-weight: bold; border-radius: 8px; padding: 10px 18px; font-size: 13px; }
        .btn-test:hover { background-color: #38bdf8; }
        .stat-val { font-size: 20px; font-weight: bold; color: #34d399; font-family: 'JetBrains Mono', monospace; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>⚡ Aero Speed &amp; Latency Studio</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#9ca3af' font='10'>Precision ping latency profiler, DNS resolver benchmarks &amp; CDN bandwidth</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        self.btn_run = Gtk.Button(label="⚡ Run Speed Test")
        self.btn_run.get_style_context().add_class("btn-test")
        self.btn_run.connect("clicked", self._on_run_test)
        header_box.pack_start(self.btn_run, False, False, 0)

        vbox.pack_start(header_box, False, False, 0)

        # Overview Metrics Grid
        metrics_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        metrics_card.get_style_context().add_class("card")
        metrics_card.set_homogeneous(True)

        # Ping Metric Box
        b_ping = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_p_tag = Gtk.Label(label="PING LATENCY", xalign=0.5)
        lbl_p_tag.set_markup("<span color='#94a3b8' font='9'>PING LATENCY</span>")
        self.lbl_ping_val = Gtk.Label(label="-- ms", xalign=0.5)
        self.lbl_ping_val.get_style_context().add_class("stat-val")
        b_ping.pack_start(lbl_p_tag, False, False, 0)
        b_ping.pack_start(self.lbl_ping_val, False, False, 0)
        metrics_card.pack_start(b_ping, True, True, 0)

        # Download Metric Box
        b_dl = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_dl_tag = Gtk.Label(label="DOWNLOAD SPEED", xalign=0.5)
        lbl_dl_tag.set_markup("<span color='#94a3b8' font='9'>DOWNLOAD SPEED</span>")
        self.lbl_dl_val = Gtk.Label(label="-- Mbps", xalign=0.5)
        self.lbl_dl_val.get_style_context().add_class("stat-val")
        b_dl.pack_start(lbl_dl_tag, False, False, 0)
        b_dl.pack_start(self.lbl_dl_val, False, False, 0)
        metrics_card.pack_start(b_dl, True, True, 0)

        # DNS Metric Box
        b_dns = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_dns_tag = Gtk.Label(label="FASTEST DNS", xalign=0.5)
        lbl_dns_tag.set_markup("<span color='#94a3b8' font='9'>FASTEST DNS</span>")
        self.lbl_dns_val = Gtk.Label(label="-- ms", xalign=0.5)
        self.lbl_dns_val.get_style_context().add_class("stat-val")
        b_dns.pack_start(lbl_dns_tag, False, False, 0)
        b_dns.pack_start(self.lbl_dns_val, False, False, 0)
        metrics_card.pack_start(b_dns, True, True, 0)

        vbox.pack_start(metrics_card, False, False, 0)

        # DNS Benchmarks Card
        dns_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        dns_card.get_style_context().add_class("card")
        
        lbl_b_title = Gtk.Label(label="<b>🌐 DNS Resolvers Benchmark</b>", xalign=0)
        lbl_b_title.set_use_markup(True)
        dns_card.pack_start(lbl_b_title, False, False, 0)

        self.dns_list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        dns_card.pack_start(self.dns_list_box, True, True, 0)

        vbox.pack_start(dns_card, True, True, 0)

        # Status
        self.lbl_status = Gtk.Label(label="Ready to benchmark connection", xalign=0)
        self.lbl_status.set_markup("<span color='#34d399' font='10'>Network Diagnostic Engine Ready</span>")
        vbox.pack_start(self.lbl_status, False, False, 0)

        self._populate_initial_dns()

    def _populate_initial_dns(self):
        for child in self.dns_list_box.get_children():
            self.dns_list_box.remove(child)

        for d in DNS_TARGETS:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            lbl_n = Gtk.Label(xalign=0)
            lbl_n.set_markup(f"<b>{d['name']}</b> <span color='#94a3b8'>({d['server']})</span>")
            lbl_r = Gtk.Label(label="-- ms", xalign=1)
            lbl_r.set_markup("<span color='#94a3b8'>Ready</span>")
            row.pack_start(lbl_n, True, True, 0)
            row.pack_start(lbl_r, False, False, 0)
            self.dns_list_box.pack_start(row, False, False, 0)

        self.dns_list_box.show_all()

    def _on_run_test(self, button):
        self.btn_run.set_sensitive(False)
        self.lbl_status.set_markup("<span color='#00f2fe' font='10'>Testing latency and DNS resolvers...</span>")
        
        def run_bench():
            # 1. Ping 1.1.1.1
            ping_ms = "Unknown"
            try:
                res = subprocess.run(["ping", "-c", "3", "-W", "2", "1.1.1.1"], capture_output=True, text=True)
                for line in res.stdout.splitlines():
                    if "rtt min/avg/max" in line or "round-trip min/avg/max" in line:
                        avg = line.split("=")[1].split("/")[1]
                        ping_ms = f"{float(avg):.1f} ms"
                        break
            except Exception:
                pass

            # 2. DNS Resolution Times
            dns_results = []
            for d in DNS_TARGETS:
                t_start = time.time()
                try:
                    res = subprocess.run(["dig", f"@{d['server']}", "github.com", "+time=2", "+tries=1"], capture_output=True, text=True)
                    elapsed = (time.time() - t_start) * 1000
                    dns_results.append({"name": d["name"], "server": d["server"], "ms": f"{elapsed:.1f} ms"})
                except Exception:
                    dns_results.append({"name": d["name"], "server": d["server"], "ms": "Timeout"})

            # 3. Quick CDN Download Throughput Test (2MB chunk)
            speed_mbps = "--"
            try:
                t0 = time.time()
                req = urllib.request.Request("https://speed.cloudflare.com/__down?bytes=5000000", headers={'User-Agent': 'Aero/1.0'})
                with urllib.request.urlopen(req, timeout=5) as response:
                    data = response.read()
                t1 = time.time()
                dur = t1 - t0
                if dur > 0:
                    mbps = (len(data) * 8 / (1024**2)) / dur
                    speed_mbps = f"{mbps:.1f} Mbps"
            except Exception:
                speed_mbps = "N/A"

            GLib.idle_add(self._update_results, ping_ms, speed_mbps, dns_results)

        threading.Thread(target=run_bench, daemon=True).start()

    def _update_results(self, ping_ms, speed_mbps, dns_results):
        self.btn_run.set_sensitive(True)
        self.lbl_ping_val.set_text(ping_ms)
        self.lbl_dl_val.set_text(speed_mbps)

        for child in self.dns_list_box.get_children():
            self.dns_list_box.remove(child)

        fastest = None
        for d in dns_results:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            lbl_n = Gtk.Label(xalign=0)
            lbl_n.set_markup(f"<b>{d['name']}</b> <span color='#94a3b8'>({d['server']})</span>")
            lbl_r = Gtk.Label(xalign=1)
            lbl_r.set_markup(f"<span color='#34d399' font='bold 11'>{d['ms']}</span>")
            row.pack_start(lbl_n, True, True, 0)
            row.pack_start(lbl_r, False, False, 0)
            self.dns_list_box.pack_start(row, False, False, 0)

        self.dns_list_box.show_all()
        if dns_results:
            self.lbl_dns_val.set_text(dns_results[0]["ms"])

        self.lbl_status.set_markup("<span color='#34d399' font='10'>✔ Network Benchmark Completed Successfully!</span>")
        subprocess.run(["notify-send", "⚡ Speed Test", f"Ping: {ping_ms} | Download: {speed_mbps}"])


def main():
    win = SpeedStudioWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
