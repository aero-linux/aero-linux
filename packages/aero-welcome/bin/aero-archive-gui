#!/usr/bin/env python3
"""
Aero Linux - Archive & Compression Studio (GTK3)
Inspect archive file trees, test integrity, extract archives, and build ZIP/TAR.GZ/TAR.XZ packages.
"""

import datetime
import gi
import os
import shutil
import subprocess
import sys
import tarfile
import threading
import zipfile

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

CSS_STYLING = b"""
* {
    font-family: 'Inter', 'Ubuntu', 'Segoe UI', sans-serif;
}
window {
    background-color: #050811;
    color: #e2e8f0;
}
.header-box {
    background: linear-gradient(135deg, #0b1329 0%, #050811 100%);
    border-bottom: 1px solid rgba(0, 242, 254, 0.25);
    padding: 16px 20px;
}
.header-title {
    font-size: 16pt;
    font-weight: 800;
    color: #ffffff;
}
.header-desc {
    font-size: 9pt;
    color: #94a3b8;
}
.code-editor {
    background-color: #080d1a;
    color: #38bdf8;
    font-family: 'JetBrains Mono', 'Fira Code', 'Monospace';
    font-size: 9pt;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px;
}
.btn-primary {
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
