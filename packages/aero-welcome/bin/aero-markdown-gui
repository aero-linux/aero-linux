#!/usr/bin/env python3
"""
Aero Linux - Markdown & Technical Documentation Studio (GTK3)
Real-time split-pane Markdown editor, GitHub-flavored syntax parser, HTML exporter, and word count statistics.
"""

import gi
import html
import os
import re
import subprocess
import sys

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

CSS_STYLING = b"""
