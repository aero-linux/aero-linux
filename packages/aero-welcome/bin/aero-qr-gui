    font-size: 9pt;
    color: #94a3b8;
}
.code-editor {
    background-color: #080d1a;
    color: #38bdf8;
    font-family: 'JetBrains Mono', 'Fira Code', 'Monospace';
    font-size: 9.5pt;
    border: 1px solid rgba(255, 255, 255, 0.08);
