#!/usr/bin/env python3
"""
Aero Linux - QR Code & Device Link Studio (GTK3)
Generate instant QR codes for URLs, Wi-Fi networks, text, and phone pairing with vector SVG & PNG export.
"""

import gi
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Pango

CSS_STYLING = b"""
* {
    font-family: 'Inter', 'Ubuntu', 'Segoe UI', sans-serif;
}
window {
    background-color: #050811;
    color: #e2e8f0;
}
.header-box {
    background: linear-gradient(135deg, #0b1329 0%, #050811 100%);
    border-bottom: 1px solid rgba(0, 242, 254, 0.25);
    padding: 16px 20px;
}
.header-title {
    font-size: 16pt;
    font-weight: 800;
    color: #ffffff;
}
