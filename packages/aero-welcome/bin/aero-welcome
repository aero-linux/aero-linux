#!/usr/bin/env python3
"""
Aero Linux - Graphical Control Center & Developer Welcome Hub
Centralized, zero-terminal graphical control panel for all 22+ native Aero Linux tools and developer services.
"""

import os
import shutil
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk


class AeroWelcomeApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Aero Control Center")
        self.set_default_size(840, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Styling
        css = b"""
        window { background-color: #0b0f19; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .header-title { font-size: 20px; font-weight: bold; color: #00f2fe; }
        .card { background-color: #111827; border-radius: 10px; padding: 12px; border: 1px solid #1f2937; }
        .btn-quick { background-color: #1e293b; color: #f8fafc; border-radius: 8px; padding: 10px 14px; font-size: 12px; font-weight: 600; text-align: left; }
        .btn-quick:hover { background-color: #334155; }
        .btn-primary-action { background-color: #0284c7; color: #ffffff; font-weight: bold; border-radius: 8px; padding: 10px 16px; font-size: 13px; }
        .btn-primary-action:hover { background-color: #0ea5e9; }
        stackswitcher button { background-color: #111827; color: #94a3b8; font-weight: bold; padding: 6px 14px; border-radius: 6px; }
        stackswitcher button:checked { background-color: #0284c7; color: #ffffff; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(main_box)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='header-title'>⚡ Aero Linux Control Center</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span color='#9ca3af' font='10'>The Ultra-Lean Operating System for AI &amp; High Performance</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header_box.pack_start(title_box, True, True, 0)

        btn_about = Gtk.Button(label="ℹ️ System Specs")
        btn_about.get_style_context().add_class("btn-quick")
        btn_about.connect("clicked", lambda b: self.run_cmd("aero-about-gui"))
        header_box.pack_start(btn_about, False, False, 0)

        btn_doc = Gtk.Button(label="🩺 1-Click Self-Repair")
        btn_doc.get_style_context().add_class("btn-primary-action")
        btn_doc.connect("clicked", lambda b: self.run_cmd("aero-repair-gui"))
        header_box.pack_start(btn_doc, False, False, 0)

        main_box.pack_start(header_box, False, False, 0)

        # Master Stack Navigation
        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        stack.set_transition_duration(200)

        # -------------------------------------------------------------
        # 1. Quick Setup & Hardware Center
        # -------------------------------------------------------------
        page_quick = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_quick.set_margin_top(10)

        lbl_q = Gtk.Label(label="<b>🛠️ Quick Settings &amp; Essential Hardware</b>", xalign=0)
        lbl_q.set_use_markup(True)
        page_quick.pack_start(lbl_q, False, False, 0)

        quick_grid = Gtk.Grid()
        quick_grid.set_column_spacing(10)
        quick_grid.set_row_spacing(10)
        quick_grid.set_column_homogeneous(True)

        q_tools = [
            ("📶 Wi-Fi & Network Scanner", "aero-wifi || nm-connection-editor", 0, 0),
            ("🎧 Bluetooth Manager", "aero-bluetooth || blueman-manager", 1, 0),
            ("🔊 PipeWire Audio Center", "aero-audio || pavucontrol", 0, 1),
            ("🖥️ Displays & HiDPI Scaling", "aero-displays || wdisplays", 1, 1),
            ("📊 Task Manager (CPU Waveform)", "aero-monitor", 0, 2),
            ("🔄 Update Manager (Patches)", "aero-updater", 1, 2),
            ("🔋 Battery Studio & Fan Curves", "aero-power-gui", 0, 3),
            ("🌙 Night Light Studio", "aero-nightlight-gui", 1, 3),
            ("⚡ Quick Action Center", "aero-quick-settings", 0, 4),
            ("🚀 Network Speed & Latency", "aero-speed-gui", 1, 4),
        ]

        for text, cmd, col, row in q_tools:
            btn = Gtk.Button(label=text)
            btn.get_style_context().add_class("btn-quick")
            btn.connect("clicked", lambda b, c=cmd: self.run_cmd(c))
            quick_grid.attach(btn, col, row, 1, 1)

        page_quick.pack_start(quick_grid, True, True, 0)
        stack.add_titled(page_quick, "quick", "Quick Settings")

        # -------------------------------------------------------------
        # 2. Developer Productivity Suite
        # -------------------------------------------------------------
        page_dev = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_dev.set_margin_top(10)

        lbl_d = Gtk.Label(label="<b>💻 Developer Productivity &amp; Utilities</b>", xalign=0)
        lbl_d.set_use_markup(True)
        page_dev.pack_start(lbl_d, False, False, 0)

        dev_grid = Gtk.Grid()
        dev_grid.set_column_spacing(10)
        dev_grid.set_row_spacing(10)
        dev_grid.set_column_homogeneous(True)

        dev_tools = [
            ("🚀 Spotlight Search (Alt+Space)", "aero-spotlight", 0, 0),
            ("🤖 Local AI & LLM Studio", "aero-ai-gui", 1, 0),
            ("🐳 Docker & Container Studio", "aero-docker-gui", 0, 1),
            ("⚡ API & HTTP Studio", "aero-api-gui", 1, 1),
            ("🗄️ Database & Query Studio", "aero-db-gui", 0, 2),
            ("🔑 Environment & .env Studio", "aero-env-gui", 1, 2),
            ("🔬 Regex & Pattern Studio", "aero-regex-gui", 0, 3),
            ("📝 Floating Scratchpad (Win+N)", "aero-notes-gui", 1, 3),
            ("🎨 Color Dropper (Win+P)", "aero-color-gui", 0, 4),
            ("📸 Snipping Tool (Win+Shift+S)", "aero-screenshot-gui || aero-screenshot", 1, 4),
            ("🔤 Typography & Font Studio", "aero-font-gui", 0, 5),
            ("🔌 Dev Server & Port Inspector", "aero-ports-gui", 1, 5),
            ("🌿 Git Workspace & Repos", "aero-git-gui", 0, 6),
            ("🔑 SSH Keys & Server Bookmarks", "aero-ssh-gui", 1, 6),
            ("🔒 Local SSL/HTTPS Cert Studio", "aero-ssl-gui", 0, 7),
            ("🛡️ Firewall & Security Shield", "aero-firewall-gui", 1, 7),
            ("🗂️ Virtual Desktops & Workspaces", "aero-workspaces-gui", 0, 8),
            ("⌨️ Keyboard Shortcuts Guide", "aero-shortcuts-gui", 1, 8),
            ("🔒 Developer Secrets Vault", "aero-vault-gui", 0, 9),
        ]

        for text, cmd, col, row in dev_tools:
            btn = Gtk.Button(label=text)
            btn.get_style_context().add_class("btn-quick")
            btn.connect("clicked", lambda b, c=cmd: self.run_cmd(c))
            dev_grid.attach(btn, col, row, 1, 1)

        page_dev.pack_start(dev_grid, True, True, 0)
        stack.add_titled(page_dev, "dev_suite", "Developer Suite")

        # -------------------------------------------------------------
        # 3. System Services, Storage & Maintenance
        # -------------------------------------------------------------
        page_maint = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_maint.set_margin_top(10)

        lbl_m = Gtk.Label(label="<b>⚙️ System Daemons, Storage &amp; Maintenance</b>", xalign=0)
        lbl_m.set_use_markup(True)
        page_maint.pack_start(lbl_m, False, False, 0)

        maint_grid = Gtk.Grid()
        maint_grid.set_column_spacing(10)
        maint_grid.set_row_spacing(10)
        maint_grid.set_column_homogeneous(True)

        maint_tools = [
            ("⚙️ Systemd Service Manager", "aero-services-gui", 0, 0),
            ("🚀 Startup Applications", "aero-startup-gui", 1, 0),
            ("⏰ Cron & Scheduled Tasks", "aero-cron-gui", 0, 1),
            ("💾 Storage & Dev Disk Cleaner", "aero-disk-gui", 1, 1),
            ("☁️ Dotfiles & Config Sync", "aero-sync-gui", 0, 2),
            ("🔥 Safe ISO USB Flasher", "aero-flasher-gui", 1, 2),
            ("📜 System & Kernel Logs", "aero-logs-gui", 0, 3),
            ("📸 TimeMachine Snapshots", "aero-snapshots-gui", 1, 3),
            ("🧹 Cache & Log Cleaner", "aero-cleaner-gui", 0, 4),
        ]

        for text, cmd, col, row in maint_tools:
            btn = Gtk.Button(label=text)
            btn.get_style_context().add_class("btn-quick")
            btn.connect("clicked", lambda b, c=cmd: self.run_cmd(c))
            maint_grid.attach(btn, col, row, 1, 1)

        page_maint.pack_start(maint_grid, True, True, 0)
        stack.add_titled(page_maint, "maint", "Services & Storage")

        # -------------------------------------------------------------
        # 4. 1-Click App Center
        # -------------------------------------------------------------
        page_store = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_store.set_margin_top(10)

        lbl_store = Gtk.Label(label="<b>📦 1-Click Developer Software Center</b>", xalign=0)
        lbl_store.set_use_markup(True)
        page_store.pack_start(lbl_store, False, False, 0)

        store_grid = Gtk.Grid()
        store_grid.set_column_spacing(10)
        store_grid.set_row_spacing(10)
        store_grid.set_column_homogeneous(True)

        apps = [
            ("💻 Visual Studio Code", "aero store install vscode", 0, 0),
            ("🦁 Brave Browser", "aero store install brave", 1, 0),
            ("🐳 Docker & Compose", "aero store install docker", 0, 1),
            ("📡 Postman API Client", "aero store install postman", 1, 1),
            ("🐘 DBeaver Database GUI", "aero store install dbeaver", 0, 2),
            ("📓 Obsidian Second Brain", "aero store install obsidian", 1, 2),
            ("⚡ Neovim Modern Editor", "aero store install neovim", 0, 3),
            ("💬 Discord for Devs", "aero store install discord", 1, 3),
        ]

        for label_text, cmd_text, col, row in apps:
            btn = Gtk.Button(label=label_text)
            btn.get_style_context().add_class("btn-quick")
            btn.connect("clicked", lambda b, c=cmd_text: self.run_cmd(f"alacritty -e {c}"))
            store_grid.attach(btn, col, row, 1, 1)

        page_store.pack_start(store_grid, True, True, 0)
        stack.add_titled(page_store, "store", "App Center")

        # -------------------------------------------------------------
        # 5. Gaming & Mobile Sync
        # -------------------------------------------------------------
        page_hw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_hw.set_margin_top(10)

        lbl_hw = Gtk.Label(label="<b>🎮 Gaming &amp; Wireless Mobile Sync</b>", xalign=0)
        lbl_hw.set_use_markup(True)
        page_hw.pack_start(lbl_hw, False, False, 0)

        hw_grid = Gtk.Grid()
        hw_grid.set_column_spacing(10)
        hw_grid.set_row_spacing(10)
        hw_grid.set_column_homogeneous(True)

        btn_game_gui = Gtk.Button(label="🎮 Aero Game Hub & Proton Optimizer")
        btn_game_gui.get_style_context().add_class("btn-quick")
        btn_game_gui.connect("clicked", lambda b: self.run_cmd("aero-gamehub"))
        hw_grid.attach(btn_game_gui, 0, 0, 1, 1)

        btn_phone_gui = Gtk.Button(label="📱 Phone Link & Wireless Drop Target")
        btn_phone_gui.get_style_context().add_class("btn-quick")
        btn_phone_gui.connect("clicked", lambda b: self.run_cmd("aero-connect-gui"))
        hw_grid.attach(btn_phone_gui, 1, 0, 1, 1)

        page_hw.pack_start(hw_grid, False, False, 0)
        stack.add_titled(page_hw, "gaming", "Gaming & Mobile")

        # -------------------------------------------------------------
        # 6. Themes & Aesthetics
        # -------------------------------------------------------------
        page_themes = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_themes.set_margin_top(10)

        lbl_themes = Gtk.Label(label="<b>🎨 Desktop Aesthetics &amp; Accent Studio</b>", xalign=0)
        lbl_themes.set_use_markup(True)
        page_themes.pack_start(lbl_themes, False, False, 0)

        btn_theme_studio = Gtk.Button(label="🎨 Open Full Aero Theme & Accent Studio")
        btn_theme_studio.get_style_context().add_class("btn-primary-action")
        btn_theme_studio.connect("clicked", lambda b: self.run_cmd("aero-theme-gui"))
        page_themes.pack_start(btn_theme_studio, False, False, 0)

        btn_auto_theme = Gtk.Button(label="🕒 Auto-Sync Theme with Sun Cycle & Battery")
        btn_auto_theme.get_style_context().add_class("btn-quick")
        btn_auto_theme.connect("clicked", lambda b: self.run_cmd("aero theme auto"))
        page_themes.pack_start(btn_auto_theme, False, False, 0)

        stack.add_titled(page_themes, "themes", "Themes")

        # Navigation Switcher
        switcher = Gtk.StackSwitcher()
        switcher.set_stack(stack)
        switcher.set_halign(Gtk.Align.CENTER)
        main_box.pack_start(switcher, False, False, 0)
        main_box.pack_start(stack, True, True, 0)

        # Status Label
        self.status_lbl = Gtk.Label(label="Ready")
        self.status_lbl.set_markup("<span color='#34d399' font='10'>Aero Control Center Ready</span>")
        main_box.pack_end(self.status_lbl, False, False, 0)

    def run_cmd(self, cmd):
        self.status_lbl.set_markup(f"<span color='#00f2fe' font='10'>Executing: {cmd}...</span>")
        try:
            subprocess.Popen(cmd, shell=True)
            self.status_lbl.set_markup(f"<span color='#34d399' font='10'>Launched {cmd.split()[0]}</span>")
        except Exception as e:
            self.status_lbl.set_markup(f"<span color='#f43f5e' font='10'>Error: {e}</span>")


def main():
    app = AeroWelcomeApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
