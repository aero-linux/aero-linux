 / ___ |/ /___ / _, _/ /_/ /  / /____/ /  |    / / /_/ //   |  
/_/  |_/_____//_/ |_|\____/  /_____/___/  |_/_/  \____//_/|_|  
    ⚡ The High-Performance AI & Developer Linux Distribution
    """)


def main():
    parser = argparse.ArgumentParser(
        description="Aero Linux Management Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # GPU & Accelerators
    gpu_parser = subparsers.add_parser("gpu", help="Detect hardware and setup NVIDIA CUDA or AMD ROCm drivers")
    gpu_sub = gpu_parser.add_subparsers(dest="gpu_action", help="GPU action")
    gpu_sub.add_parser("setup", help="Auto-detect GPU and configure drivers + Wayland acceleration + Container Toolkit")
    gpu_sub.add_parser("nvidia", help="Install official NVIDIA driver + Wayland KMS + AI Container Toolkit")
    gpu_sub.add_parser("rocm", help="Install AMD ROCm runtime permissions and PyTorch environment variables")

    # Doctor
    doc_parser = subparsers.add_parser("doctor", help="Inspect hardware, kernel, battery, and AI readiness")
    doc_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # Power
    pow_parser = subparsers.add_parser("power", help="Manage power profiles and battery health")
    pow_parser.add_argument("profile", nargs="?", choices=list(PROFILES.keys()), help="Set active power profile")
    pow_parser.add_argument("--threshold", type=int, help="Set battery charge limit (e.g. 80)")

    # Memory
    mem_parser = subparsers.add_parser("memory", help="Optimize RAM, zRAM compaction, and inspect memory")
    mem_parser.add_argument("--optimize", action="store_true", help="Trigger zRAM compaction and cache drop")
    mem_parser.add_argument("--top", action="store_true", help="Show top memory consuming processes")

    # AI
    ai_parser = subparsers.add_parser("ai", help="Local AI runtime & model management")
    ai_sub = ai_parser.add_subparsers(dest="ai_action", help="AI subcommands")
    ai_sub.add_parser("init", help="Install and initialize local Ollama AI runtime")
    ai_sub.add_parser("status", help="Show status of local AI daemon and downloaded models")
    ai_pull = ai_sub.add_parser("pull", help="Download an LLM model")
    ai_pull.add_argument("model", help="Model name (e.g. llama3.2, deepseek-r1:8b, qwen2.5-coder)")
    ai_run = ai_sub.add_parser("run", help="Run an interactive session with a model")
    ai_run.add_argument("model", help="Model name (e.g. llama3.2, qwen2.5-coder)")
    
    ai_calc = ai_sub.add_parser("calc", help="Calculate RAM/zRAM requirements for a model size and quantization")
    ai_calc.add_argument("--params", type=float, default=8.0, help="Model parameters in billions (e.g. 7, 8, 14, 32, 70)")
    ai_calc.add_argument("--quant", default="q4_k_m", help="Quantization (fp16, q8_0, q6_k, q5_k_m, q4_k_m, q3_k_m, q2_k)")
    ai_calc.add_argument("--ctx", type=int, default=4096, help="Context window token size (default: 4096)")

    ai_bench = ai_sub.add_parser("bench", help="Benchmark local inference speed and tok/s throughput")
    ai_bench.add_argument("model", nargs="?", default="deepseek-r1:8b", help="Model to benchmark")

    # Dev Environments & Stacks
    dev_parser = subparsers.add_parser("dev", help="Instant zero-pollution isolated dev workspaces & stack installers")
    dev_sub = dev_parser.add_subparsers(dest="dev_action", help="Dev subcommands")
    dev_sub.add_parser("list", help="List all available isolated dev environments")
    dev_run = dev_sub.add_parser("run", help="Run an isolated dev environment in current directory")
    dev_run.add_argument("env", choices=list(ENVIRONMENTS.keys()), help="Environment name (node, python, rust, go, c, java, ai, postgres, redis)")
    dev_setup = dev_sub.add_parser("setup", help="1-Click native developer toolchain installer")
    dev_setup.add_argument("stack", choices=list(NATIVE_STACKS.keys()), help="Stack name (node, rust, python, java, docker, c)")

    # Package Manager Wrapper
    pkg_parser = subparsers.add_parser("pkg", help="Unified fast package manager and cache pruner")
    pkg_sub = pkg_parser.add_subparsers(dest="pkg_action", help="Package actions")
    pkg_sub.add_parser("update", help="Update all APT and Flatpak repositories")
    pkg_sub.add_parser("clean", help="Prune unused dependencies and clear package caches")
    pkg_in = pkg_sub.add_parser("install", help="Install packages")
    pkg_in.add_argument("packages", nargs="+", help="Package names to install")

    # Snapshot & Rollback
    snap_parser = subparsers.add_parser("snapshot", help="Zero-latency system restore snapshots")
    snap_sub = snap_parser.add_subparsers(dest="snap_action", help="Snapshot subcommands")
    snap_create = snap_sub.add_parser("create", help="Create a new restore snapshot")
    snap_create.add_argument("name", nargs="?", default="", help="Optional snapshot label")
    snap_sub.add_parser("list", help="List available restore points")
    snap_rest = snap_sub.add_parser("restore", help="Restore system from a snapshot")
    snap_rest.add_argument("name", help="Snapshot name/tag to restore")

    # Network & DNS Optimizer
    net_parser = subparsers.add_parser("net", help="Low-latency network, BBR TCP, and DNS optimizer")
    net_sub = net_parser.add_subparsers(dest="net_action", help="Network actions")
    net_sub.add_parser("bbr", help="Enable Google BBR TCP Congestion Control")
    net_dns = net_sub.add_parser("dns", help="Set encrypted DNS-over-TLS provider")
    net_dns.add_argument("provider", choices=list(DNS_PROVIDERS.keys()), help="DNS provider (cloudflare, quad9, google)")
    net_sub.add_parser("wifi", help="Disable WiFi power-save mode for low jitter")

    # Live Monitor
    subparsers.add_parser("monitor", help="Launch live interactive terminal system & AI monitor")

    # Keyboard & Shortcuts Cheatsheet
    subparsers.add_parser("keys", help="Display Aero desktop hotkeys and command shortcuts")

    # Dotfiles Backup & Restore
    backup_parser = subparsers.add_parser("backup", help="Export and restore encrypted dotfile configurations")
    backup_sub = backup_parser.add_subparsers(dest="backup_action", help="Backup actions")
    backup_exp = backup_sub.add_parser("export", help="Export desktop dotfiles to archive")
    backup_exp.add_argument("--output", "-o", help="Custom archive destination path")
    backup_imp = backup_sub.add_parser("import", help="Restore desktop dotfiles from archive")
    backup_imp.add_argument("file", help="Path to archive file")

    # Security & Hardening
    sec_parser = subparsers.add_parser("security", help="Kernel security audit and firewall hardening")
    sec_sub = sec_parser.add_subparsers(dest="sec_action", help="Security actions")
    sec_sub.add_parser("audit", help="Run kernel and network security audit")
    sec_sub.add_parser("harden", help="Apply kernel lockdown and firewall hardening")

    # Benchmark
    subparsers.add_parser("benchmark", help="Run multi-core CPU, RAM bandwidth, and disk benchmark")

    # GameMode
    gm_parser = subparsers.add_parser("gamemode", help="Low-latency game and Wine/Proton launcher optimizer")
    gm_sub = gm_parser.add_subparsers(dest="gm_action", help="GameMode subcommands")
    gm_run = gm_sub.add_parser("run", help="Run command with GameMode optimizations")
    gm_run.add_argument("command_to_run", nargs="+", help="Game executable or command")

    # Logs
    log_parser = subparsers.add_parser("logs", help="Analyze system errors, kernel panics, and boot timings")
    log_parser.add_argument("type", nargs="?", default="error", choices=["error", "kernel", "boot", "all"], help="Log type to inspect")

    # Port Inspector
    port_parser = subparsers.add_parser("port", help="Inspect and kill active listening developer ports")
    port_sub = port_parser.add_subparsers(dest="port_action", help="Port actions")
    port_sub.add_parser("list", help="List active listening ports and services")
    port_kill = port_sub.add_parser("kill", help="Kill process listening on a port")
    port_kill.add_argument("port_number", help="Port number to terminate (e.g. 3000, 5432)")

    # Docker Tools
    docker_parser = subparsers.add_parser("docker", help="Docker engine cleanup and container resource monitor")
    docker_sub = docker_parser.add_subparsers(dest="docker_action", help="Docker actions")
    docker_sub.add_parser("prune", help="Clean unused containers, images, and volumes")
    docker_sub.add_parser("stats", help="Show live CPU and memory usage of running containers")

    # SDK Environment
    env_parser = subparsers.add_parser("env", help="Audit installed SDKs, compilers, and toolchains")
    env_sub = env_parser.add_subparsers(dest="env_action", help="Environment actions")
    env_sub.add_parser("check", help="Check versions of Node, Python, C, Rust, Go, Java, Docker")

    # Display & Wayland
    disp_parser = subparsers.add_parser("display", help="Query Wayland output resolutions, refresh rates, and monitors")
    disp_sub = disp_parser.add_subparsers(dest="display_action", help="Display actions")
    disp_sub.add_parser("status", help="Show active monitors and Wayland session")
    night_p = disp_sub.add_parser("night", help="Toggle Blue Light Eye Protection (Night Light)")
    night_p.add_argument("state", nargs="?", choices=["on", "off"], default="on", help="Night light state (default: on)")
    night_p.add_argument("--temp", type=int, default=4500, help="Color temperature in Kelvin (default: 4500)")

    # Interactive Shell
    subparsers.add_parser("shell", help="Launch interactive Aero developer shell")

    # Thermals & Fan Sensors
    subparsers.add_parser("temp", help="Inspect CPU and GPU hardware core temperatures")

    # Git Tools
    git_parser = subparsers.add_parser("git", help="Developer Git workspace inspector and branch cleaner")
    git_sub = git_parser.add_subparsers(dest="git_action", help="Git actions")
    git_sub.add_parser("status", help="Inspect active repository and uncommitted changes")
    git_sub.add_parser("scan", help="Scan and list all local git repositories and status")
    git_sub.add_parser("clean", help="Prune merged local Git branches")
    git_sub.add_parser("graph", help="Show colorized ASCII commit topology graph")
    git_sub.add_parser("churn", help="Show top changed files in recent repository history")

    # Cron & Timers
    cron_parser = subparsers.add_parser("cron", help="Manage automated background maintenance timers")
    cron_sub = cron_parser.add_subparsers(dest="cron_action", help="Cron actions")
    cron_sub.add_parser("status", help="Show active systemd timers")
    cron_sub.add_parser("enable", help="Enable daily automated cache & memory maintenance")

    # Clipboard Manager
    clip_parser = subparsers.add_parser("clip", help="Wayland clipboard manager")
    clip_sub = clip_parser.add_subparsers(dest="clip_action", help="Clipboard actions")
    clip_sub.add_parser("clear", help="Clear all clipboard buffers")
    clip_sub.add_parser("menu", help="Open visual searchable clipboard history menu (Win+V)")
    clip_sub.add_parser("history", help="List recent clipboard history")

    # Recycle Bin / Trash
    trash_parser = subparsers.add_parser("trash", help="Recycle bin and deleted files manager")
    trash_sub = trash_parser.add_subparsers(dest="trash_action", help="Trash actions")
    trash_sub.add_parser("list", help="List files in Recycle Bin / Trash")
    trash_sub.add_parser("empty", help="Empty Recycle Bin / Trash")

    # Themes & Accent Color Studio
    theme_parser = subparsers.add_parser("theme", help="Desktop aesthetic and palette switcher")
    theme_sub = theme_parser.add_subparsers(dest="theme_action", help="Theme actions")
    theme_sub.add_parser("list", help="List available desktop themes")
    theme_sub.add_parser("auto", help="Auto-sync theme with day/night solar cycle & battery status")
    theme_set = theme_sub.add_parser("set", help="Apply a desktop theme")
    theme_set.add_argument("name", choices=list(THEMES.keys()), help="Theme name (cyber-cyan, tokyo-night, nord, gruvbox)")
    theme_acc = theme_sub.add_parser("accent", help="Set desktop highlight accent color (cyan, purple, emerald, rose, amber, arctic)")
    theme_acc.add_argument("color", nargs="?", default="cyan", help="Accent color name or HEX (default: cyan)")

    # SSH Tools
    ssh_parser = subparsers.add_parser("ssh", help="Ed25519 SSH key generation, copy, and auth test")
    ssh_sub = ssh_parser.add_subparsers(dest="ssh_action", help="SSH actions")
    ssh_sub.add_parser("status", help="List available SSH keys and permissions")
    ssh_gen = ssh_sub.add_parser("gen", help="Generate a new Ed25519 SSH keypair")
    ssh_gen.add_argument("--email", default="developer@aero-linux.org", help="Key comment/email")
    ssh_sub.add_parser("copy", help="Copy public SSH key to clipboard")
    ssh_sub.add_parser("test", help="Test GitHub SSH authentication")

    # Disk Space Tools
    disk_parser = subparsers.add_parser("disk", help="Disk usage analyzer and large file cleaner")
    disk_sub = disk_parser.add_subparsers(dest="disk_action", help="Disk actions")
    disk_top = disk_sub.add_parser("top", help="Find large files on disk")
    disk_top.add_argument("--dir", default=".", help="Directory to scan")
    disk_top.add_argument("--min-mb", type=int, default=100, help="Minimum file size in MB")
    disk_clean = disk_sub.add_parser("clean-node-modules", help="Prune node_modules folders in directory")
    disk_clean.add_argument("--dir", default=".", help="Root directory to clean")

    # Local Share Server
    share_parser = subparsers.add_parser("share", help="Start instant local network HTTP file server")
    share_parser.add_argument("path", nargs="?", default=".", help="File or directory path to serve")
    share_parser.add_argument("--port", type=int, default=8080, help="Port to listen on (default 8080)")

    # Battery Health
    subparsers.add_parser("battery", help="Inspect lithium battery wear, cycles, and health")

    # Audio Engine
    audio_parser = subparsers.add_parser("audio", help="PipeWire audio latency & DSP buffer management")
    audio_sub = audio_parser.add_subparsers(dest="audio_action", help="Audio actions")
    audio_sub.add_parser("status", help="Show audio server and latency status")
    audio_lat = audio_sub.add_parser("latency", help="Set PipeWire audio latency preset")
    audio_lat.add_argument("preset", choices=list(LATENCY_PRESETS.keys()), help="Latency preset (low, medium, high)")

    # Bluetooth
    bt_parser = subparsers.add_parser("bt", help="Bluetooth controller and power-saving management")
    bt_sub = bt_parser.add_subparsers(dest="bt_action", help="Bluetooth actions")
    bt_sub.add_parser("status", help="Show controller and connected devices")
    bt_sub.add_parser("on", help="Power ON Bluetooth controller")
    bt_sub.add_parser("off", help="Power OFF Bluetooth controller (saves battery)")

    # VPN & Mesh
    vpn_parser = subparsers.add_parser("vpn", help="WireGuard & Tailscale mesh network management")
    vpn_sub = vpn_parser.add_subparsers(dest="vpn_action", help="VPN actions")
    vpn_sub.add_parser("status", help="Show active VPN tunnels")
    vpn_up = vpn_sub.add_parser("up", help="Bring WireGuard tunnel UP")
    vpn_up.add_argument("interface", help="WireGuard interface name (e.g. wg0)")
    vpn_down = vpn_sub.add_parser("down", help="Bring WireGuard tunnel DOWN")
    vpn_down.add_argument("interface", help="WireGuard interface name (e.g. wg0)")

    # Fonts
    font_parser = subparsers.add_parser("font", help="Developer Nerd Font manager")
    font_sub = font_parser.add_subparsers(dest="font_action", help="Font actions")
    font_sub.add_parser("list", help="List available Nerd Fonts")
    font_in = font_sub.add_parser("install", help="Download and install a Nerd Font")
    font_in.add_argument("name", choices=list(NERD_FONTS.keys()), help="Font name")

    # Databases
    db_parser = subparsers.add_parser("db", help="Local containerized database suite")
    db_sub = db_parser.add_subparsers(dest="db_action", help="Database actions")
    db_sub.add_parser("list", help="List supported databases")
    db_start = db_sub.add_parser("start", help="Start a local database container")
    db_start.add_argument("name", choices=list(DATABASES.keys()), help="Database name")
    db_stop = db_sub.add_parser("stop", help="Stop a database container")
    db_stop.add_argument("name", choices=list(DATABASES.keys()), help="Database name")
    db_ui_p = db_sub.add_parser("ui", help="Launch browser-based database management studio")
    db_ui_p.add_argument("name", nargs="?", default="postgres", choices=list(DATABASES.keys()), help="Database name (default: postgres)")
    db_ui_p.add_argument("--port", "-p", type=int, default=8081, help="Studio port (default: 8081)")

    # API Benchmarking
    api_parser = subparsers.add_parser("api", help="API load testing and benchmarking")
    api_sub = api_parser.add_subparsers(dest="api_action", help="API actions")
    api_bench = api_sub.add_parser("bench", help="Run HTTP load benchmark against URL")
    api_bench.add_argument("url", help="Target URL (e.g. http://localhost:3000/api/users)")
    api_bench.add_argument("--count", "-c", type=int, default=100, help="Total requests (default 100)")
    api_bench.add_argument("--concurrency", "-w", type=int, default=10, help="Concurrent workers (default 10)")

    # Micro-VMs
    vm_parser = subparsers.add_parser("vm", help="QEMU/KVM micro-VM runner")
    vm_sub = vm_parser.add_subparsers(dest="vm_action", help="VM actions")
    vm_run = vm_sub.add_parser("run", help="Boot ISO file in accelerated micro-VM")
    vm_run.add_argument("iso", help="Path to ISO image")
    vm_run.add_argument("--ram", type=int, default=4096, help="RAM in MB (default 4096)")
    vm_run.add_argument("--cores", type=int, default=4, help="CPU cores (default 4)")

    # System Updater
    sys_parser = subparsers.add_parser("system", help="OS and Kernel upgrade manager")
    sys_sub = sys_parser.add_subparsers(dest="sys_action", help="System actions")
    sys_sub.add_parser("info", help="Check active kernel flavor and release")
    sys_sub.add_parser("update", help="Upgrade base packages and Aero CLI")

    # Desktop Layout Switcher
    layout_parser = subparsers.add_parser("layout", help="Switch between Windows-Friendly and Tiling desktop layouts")
    layout_parser.add_argument("mode", choices=["windows", "tiling"], help="Desktop layout mode (windows or tiling)")

    # Kernel & Sysctl Tuning
    ker_parser = subparsers.add_parser("kernel", help="Kernel scheduler & low-latency sysctl management")
    ker_sub = ker_parser.add_subparsers(dest="kernel_action", help="Kernel actions")
    ker_sub.add_parser("audit", help="Audit active memory, scheduler, and network sysctl parameters")
    ker_prof = ker_sub.add_parser("profile", help="Apply kernel scheduler profile")
    ker_prof.add_argument("name", choices=list(KERNEL_PROFILES.keys()), help="Profile name (lowlatency, throughput, powersave)")

    # Developer Vault & Secrets Keyring
    vault_parser = subparsers.add_parser("vault", help="Encrypted local developer keyring & secrets manager")
    vault_sub = vault_parser.add_subparsers(dest="vault_action", help="Vault actions")
