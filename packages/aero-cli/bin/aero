#!/usr/bin/env python3
"""
Aero Linux System & AI Control CLI
"""
import argparse
import sys
import json

from aero.doctor import run_doctor
from aero.power import set_profile, get_current_profile, PROFILES, set_charge_threshold
from aero.memory import compact_memory, get_top_memory_processes
from aero.ai import install_ollama, get_ai_status, pull_model, run_model
from aero.gpu import setup_nvidia_driver, setup_rocm_driver
from aero.dev import list_dev_environments, run_dev_environment, ENVIRONMENTS
from aero.pkg import update_packages, clean_system, install_packages
from aero.snapshot import create_snapshot, list_snapshots, restore_snapshot
from aero.net import enable_bbr, set_dns, optimize_wifi_latency, DNS_PROVIDERS
from aero.monitor import run_live_monitor
from aero.keys import list_keybinds
from aero.backup import export_backup, import_backup
from aero.security import audit_security, harden_system
from aero.benchmark import run_benchmark
from aero.gamemode import run_game
from aero.logs import show_logs


def print_banner():
    print(r"""
    ___    ______ ____  ____     __    _____   __  ___  __  __
   /   |  / ____// __ \/ __ \   / /   /  _/ | / / / / / / |/ /
  / /| | / __/  / /_/ / / / /  / /    / / |  |/ / / / / /|   / 
 / ___ |/ /___ / _, _/ /_/ /  / /____/ /  |    / / /_/ //   |  
/_/  |_/_____//_/ |_|\____/  /_____/___/  |_/_/  \____//_/|_|  
    ⚡ The High-Performance AI & Developer Linux Distribution
    """)


def main():
    parser = argparse.ArgumentParser(
        description="Aero Linux Management Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # GPU & Accelerators
    gpu_parser = subparsers.add_parser("gpu", help="Detect hardware and setup NVIDIA CUDA or AMD ROCm drivers")
    gpu_sub = gpu_parser.add_subparsers(dest="gpu_action", help="GPU action")
    gpu_sub.add_parser("setup", help="Auto-detect GPU and configure drivers + Wayland acceleration + Container Toolkit")
    gpu_sub.add_parser("nvidia", help="Install official NVIDIA driver + Wayland KMS + AI Container Toolkit")
    gpu_sub.add_parser("rocm", help="Install AMD ROCm runtime permissions and PyTorch environment variables")

    # Doctor
    doc_parser = subparsers.add_parser("doctor", help="Inspect hardware, kernel, battery, and AI readiness")
    doc_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # Power
    pow_parser = subparsers.add_parser("power", help="Manage power profiles and battery health")
    pow_parser.add_argument("profile", nargs="?", choices=list(PROFILES.keys()), help="Set active power profile")
    pow_parser.add_argument("--threshold", type=int, help="Set battery charge limit (e.g. 80)")

    # Memory
    mem_parser = subparsers.add_parser("memory", help="Optimize RAM, zRAM compaction, and inspect memory")
    mem_parser.add_argument("--optimize", action="store_true", help="Trigger zRAM compaction and cache drop")
    mem_parser.add_argument("--top", action="store_true", help="Show top memory consuming processes")

    # AI
    ai_parser = subparsers.add_parser("ai", help="Local AI runtime & model management")
    ai_sub = ai_parser.add_subparsers(dest="ai_action", help="AI subcommands")
    ai_sub.add_parser("init", help="Install and initialize local Ollama AI runtime")
    ai_sub.add_parser("status", help="Show status of local AI daemon and downloaded models")
    ai_pull = ai_sub.add_parser("pull", help="Download an LLM model")
    ai_pull.add_argument("model", help="Model name (e.g. llama3.2, deepseek-r1:8b, qwen2.5-coder)")
    ai_run = ai_sub.add_parser("run", help="Run an interactive session with a model")
    ai_run.add_argument("model", help="Model name (e.g. llama3.2, qwen2.5-coder)")

    # Dev Environments
    dev_parser = subparsers.add_parser("dev", help="Instant zero-pollution isolated dev workspaces")
    dev_sub = dev_parser.add_subparsers(dest="dev_action", help="Dev subcommands")
    dev_sub.add_parser("list", help="List all available isolated dev environments")
    dev_run = dev_sub.add_parser("run", help="Run an isolated dev environment in current directory")
    dev_run.add_argument("env", choices=list(ENVIRONMENTS.keys()), help="Environment name (node, python, rust, go, c, postgres, redis)")

    # Package Manager Wrapper
    pkg_parser = subparsers.add_parser("pkg", help="Unified fast package manager and cache pruner")
    pkg_sub = pkg_parser.add_subparsers(dest="pkg_action", help="Package actions")
    pkg_sub.add_parser("update", help="Update all APT and Flatpak repositories")
    pkg_sub.add_parser("clean", help="Prune unused dependencies and clear package caches")
    pkg_in = pkg_sub.add_parser("install", help="Install packages")
    pkg_in.add_argument("packages", nargs="+", help="Package names to install")

    # Snapshot & Rollback
    snap_parser = subparsers.add_parser("snapshot", help="Zero-latency system restore snapshots")
    snap_sub = snap_parser.add_subparsers(dest="snap_action", help="Snapshot subcommands")
    snap_create = snap_sub.add_parser("create", help="Create a new restore snapshot")
    snap_create.add_argument("name", nargs="?", default="", help="Optional snapshot label")
    snap_sub.add_parser("list", help="List available restore points")
    snap_rest = snap_sub.add_parser("restore", help="Restore system from a snapshot")
    snap_rest.add_argument("name", help="Snapshot name/tag to restore")

    # Network & DNS Optimizer
    net_parser = subparsers.add_parser("net", help="Low-latency network, BBR TCP, and DNS optimizer")
    net_sub = net_parser.add_subparsers(dest="net_action", help="Network actions")
    net_sub.add_parser("bbr", help="Enable Google BBR TCP Congestion Control")
    net_dns = net_sub.add_parser("dns", help="Set encrypted DNS-over-TLS provider")
    net_dns.add_argument("provider", choices=list(DNS_PROVIDERS.keys()), help="DNS provider (cloudflare, quad9, google)")
    net_sub.add_parser("wifi", help="Disable WiFi power-save mode for low jitter")

    # Live Monitor
    subparsers.add_parser("monitor", help="Launch live interactive terminal system & AI monitor")

    # Keyboard & Shortcuts Cheatsheet
    subparsers.add_parser("keys", help="Display Aero desktop hotkeys and command shortcuts")

    # Dotfiles Backup & Restore
    backup_parser = subparsers.add_parser("backup", help="Export and restore encrypted dotfile configurations")
    backup_sub = backup_parser.add_subparsers(dest="backup_action", help="Backup actions")
    backup_exp = backup_sub.add_parser("export", help="Export desktop dotfiles to archive")
    backup_exp.add_argument("--output", "-o", help="Custom archive destination path")
    backup_imp = backup_sub.add_parser("import", help="Restore desktop dotfiles from archive")
    backup_imp.add_argument("file", help="Path to archive file")

    # Security & Hardening
    sec_parser = subparsers.add_parser("security", help="Kernel security audit and firewall hardening")
    sec_sub = sec_parser.add_subparsers(dest="sec_action", help="Security actions")
    sec_sub.add_parser("audit", help="Run kernel and network security audit")
    sec_sub.add_parser("harden", help="Apply kernel lockdown and firewall hardening")

    # Benchmark
    subparsers.add_parser("benchmark", help="Run multi-core CPU, RAM bandwidth, and disk benchmark")

    # GameMode
    gm_parser = subparsers.add_parser("gamemode", help="Low-latency game and Wine/Proton launcher optimizer")
    gm_sub = gm_parser.add_subparsers(dest="gm_action", help="GameMode subcommands")
    gm_run = gm_sub.add_parser("run", help="Run command with GameMode optimizations")
    gm_run.add_argument("command_to_run", nargs="+", help="Game executable or command")

    # Logs
    log_parser = subparsers.add_parser("logs", help="Analyze system errors, kernel panics, and boot timings")
    log_parser.add_argument("type", nargs="?", default="error", choices=["error", "kernel", "boot", "all"], help="Log type to inspect")

    args = parser.parse_args()

    if not args.command:
        print_banner()
        parser.print_help()
        sys.exit(0)

    if args.command == "gpu":
        if args.gpu_action == "nvidia":
            setup_nvidia_driver()
        elif args.gpu_action == "rocm":
            setup_rocm_driver()
        elif args.gpu_action == "setup" or not args.gpu_action:
            report = run_doctor()
            nvidia = any(g.get("vendor") == "NVIDIA" for g in report["gpus"])
            amd = any(g.get("vendor") == "AMD" for g in report["gpus"])
            if nvidia:
                setup_nvidia_driver()
            elif amd:
                setup_rocm_driver()
            else:
                print("ℹ️ Standard Integrated Graphics detected. Intel/Mesa drivers are already active.")

    elif args.command == "doctor":
        report = run_doctor()
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print_banner()
            print(f"🖥️  OS: {report['os']} (Kernel: {report['kernel']})")
            print(f"⚙️  CPU: {report['cpu']['model']} ({report['cpu']['cores']} cores) [Governor: {report['cpu']['governor']}]")
            print(f"🧠 RAM: {report['memory']['available_mb']}MB available / {report['memory']['total_mb']}MB total (zRAM Active: {report['memory']['zram_active']})")
            
            if report['gpus']:
                print("🎮 GPU(s):")
                for g in report['gpus']:
                    print(f"   - {g['vendor']}: {g['model']}")
            else:
                print("🎮 GPU: Integrated / Standard Graphics")

            if report['battery']['present']:
                print(f"🔋 Battery: {report['battery']['percentage']}% ({report['battery']['status']})")
            
            print(f"🤖 AI Stack: Docker={report['ai_stack']['docker']}, Ollama={report['ai_stack']['ollama']}, Python={report['ai_stack']['python']}")

    elif args.command == "power":
        if args.threshold:
            success = set_charge_threshold(args.threshold)
            print(f"🔋 Battery charge threshold set to {args.threshold}%: {'Success' if success else 'Failed'}")
        elif args.profile:
            set_profile(args.profile)
            print(f"⚡ Power profile switched to: {args.profile.upper()}")
            print(f"   ℹ️  {PROFILES[args.profile]['description']}")
        else:
            current = get_current_profile()
            print(f"⚡ Current Power Profile: {current.upper()}")
            print("\nAvailable profiles:")
            for name, p in PROFILES.items():
                print(f"   • {name:10} - {p['description']}")

    elif args.command == "memory":
        if args.top or not args.optimize:
            print("🧠 Top 10 Memory Consuming Processes:")
            for p in get_top_memory_processes(10):
                print(f"   PID {p['pid']:<6} {p['mem_percent']:>5.1f}% ({p['rss_mb']:>5}MB) - {p['command']}")
        if args.optimize:
            print("\n🧹 Compacting zRAM and dropping caches...")
            res = compact_memory()
            print(f"✅ Optimization complete! Freed: ~{res['memory_freed_mb']}MB RAM")

    elif args.command == "ai":
        if args.ai_action == "init":
            install_ollama()
        elif args.ai_action == "status":
            st = get_ai_status()
            print(f"🤖 Ollama Installed: {st['ollama_installed']}")
            print(f"🟢 Daemon Running:  {st['ollama_running']}")
            if st["models"]:
                print("📦 Installed Models:")
                for m in st["models"]:
                    print(f"   • {m}")
            else:
                print("📦 No models installed yet. Run 'aero ai pull llama3.2' to get started.")
        elif args.ai_action == "pull":
            pull_model(args.model)
        elif args.ai_action == "run":
            run_model(args.model)
        else:
            ai_parser.print_help()

    elif args.command == "dev":
        if args.dev_action == "list" or not args.dev_action:
            list_dev_environments()
        elif args.dev_action == "run":
            run_dev_environment(args.env)

    elif args.command == "pkg":
        if args.pkg_action == "update":
            update_packages()
        elif args.pkg_action == "clean":
            clean_system()
        elif args.pkg_action == "install":
            install_packages(args.packages)
        else:
            pkg_parser.print_help()

    elif args.command == "snapshot":
        if args.snap_action == "create":
            create_snapshot(args.name)
        elif args.snap_action == "list" or not args.snap_action:
            list_snapshots()
        elif args.snap_action == "restore":
            restore_snapshot(args.name)

    elif args.command == "net":
        if args.net_action == "bbr":
            enable_bbr()
        elif args.net_action == "dns":
            set_dns(args.provider)
        elif args.net_action == "wifi":
            optimize_wifi_latency()
        else:
            net_parser.print_help()

    elif args.command == "monitor":
        run_live_monitor()

    elif args.command == "keys":
        list_keybinds()

    elif args.command == "backup":
        if args.backup_action == "export":
            export_backup(args.output)
        elif args.backup_action == "import":
            import_backup(args.file)
        else:
            backup_parser.print_help()

    elif args.command == "security":
        if args.sec_action == "audit" or not args.sec_action:
            audit_security()
        elif args.sec_action == "harden":
            harden_system()

    elif args.command == "benchmark":
        run_benchmark()

    elif args.command == "gamemode":
        if args.gm_action == "run":
            run_game(args.command_to_run)
        else:
            gm_parser.print_help()

    elif args.command == "logs":
        show_logs(args.type)


if __name__ == "__main__":
    main()
