    zoom_peek_p.add_argument("--scale", type=float, default=1.35, help="Peek zoom scale factor")
    zoom_peek_p.add_argument("--duration", type=float, default=1.8, help="Peek duration in seconds before reset")
    zoom_set = zoom_sub.add_parser("set", help="Set specific zoom scale factor")
    zoom_set.add_argument("scale", type=float, help="Scale factor (e.g. 1.25, 1.5, 2.0)")

    # System Self-Repair & Integrity Engine
    subparsers.add_parser("repair", help="System integrity diagnostic and 1-click self-repair engine")

    args = parser.parse_args()

    if not args.command:
        print_banner()
        parser.print_help()
        sys.exit(0)

    if args.command == "gpu":
        if args.gpu_action == "nvidia":
            setup_nvidia_driver()
        elif args.gpu_action == "rocm":
            setup_rocm_driver()
        elif args.gpu_action == "setup" or not args.gpu_action:
            report = run_doctor()
            nvidia = any(g.get("vendor") == "NVIDIA" for g in report["gpus"])
            amd = any(g.get("vendor") == "AMD" for g in report["gpus"])
            if nvidia:
                setup_nvidia_driver()
            elif amd:
                setup_rocm_driver()
            else:
                print("ℹ️ Standard Integrated Graphics detected. Intel/Mesa drivers are already active.")

    elif args.command == "doctor":
        report = run_doctor()
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print_banner()
            print(f"🖥️  OS: {report['os']} (Kernel: {report['kernel']})")
            print(f"⚙️  CPU: {report['cpu']['model']} ({report['cpu']['cores']} cores) [Governor: {report['cpu']['governor']}]")
            print(f"🧠 RAM: {report['memory']['available_mb']}MB available / {report['memory']['total_mb']}MB total (zRAM Active: {report['memory']['zram_active']})")
            
            if report['gpus']:
                print("🎮 GPU(s):")
                for g in report['gpus']:
                    print(f"   - {g['vendor']}: {g['model']}")
            else:
                print("🎮 GPU: Integrated / Standard Graphics")

            if report['battery']['present']:
                print(f"🔋 Battery: {report['battery']['percentage']}% ({report['battery']['status']})")
            
            print(f"🤖 AI Stack: Docker={report['ai_stack']['docker']}, Ollama={report['ai_stack']['ollama']}, Python={report['ai_stack']['python']}")

    elif args.command == "power":
        if args.threshold:
            success = set_charge_threshold(args.threshold)
            print(f"🔋 Battery charge threshold set to {args.threshold}%: {'Success' if success else 'Failed'}")
        elif args.profile:
            set_profile(args.profile)
            print(f"⚡ Power profile switched to: {args.profile.upper()}")
            print(f"   ℹ️  {PROFILES[args.profile]['description']}")
        else:
            current = get_current_profile()
            print(f"⚡ Current Power Profile: {current.upper()}")
            print("\nAvailable profiles:")
            for name, p in PROFILES.items():
                print(f"   • {name:10} - {p['description']}")

    elif args.command == "memory":
        if args.top or not args.optimize:
            print("🧠 Top 10 Memory Consuming Processes:")
            for p in get_top_memory_processes(10):
                print(f"   PID {p['pid']:<6} {p['mem_percent']:>5.1f}% ({p['rss_mb']:>5}MB) - {p['command']}")
        if args.optimize:
            print("\n🧹 Compacting zRAM and dropping caches...")
            res = compact_memory()
            print(f"✅ Optimization complete! Freed: ~{res['memory_freed_mb']}MB RAM")

    elif args.command == "ai":
        if args.ai_action == "init":
            install_ollama()
        elif args.ai_action == "status":
            st = get_ai_status()
            print(f"🤖 Ollama Installed: {st['ollama_installed']}")
            print(f"🟢 Daemon Running:  {st['ollama_running']}")
            if st["models"]:
                print("📦 Installed Models:")
                for m in st["models"]:
                    print(f"   • {m}")
            else:
                print("📦 No models installed yet. Run 'aero ai pull llama3.2' to get started.")
        elif args.ai_action == "pull":
            pull_model(args.model)
        elif args.ai_action == "run":
            run_model(args.model)
        elif args.ai_action == "calc":
            print_memory_calc(args.params, args.quant, args.ctx)
        elif args.ai_action == "bench":
            benchmark_model_speed(args.model)
        else:
            ai_parser.print_help()

    elif args.command == "dev":
        if args.dev_action == "list" or not args.dev_action:
            list_dev_environments()
        elif args.dev_action == "run":
            run_dev_environment(args.env)
        elif args.dev_action == "setup":
            install_native_stack(args.stack)

    elif args.command == "pkg":
        if args.pkg_action == "update":
            update_packages()
        elif args.pkg_action == "clean":
            clean_system()
        elif args.pkg_action == "install":
            install_packages(args.packages)
        else:
            pkg_parser.print_help()

    elif args.command == "snapshot":
        if args.snap_action == "create":
            create_snapshot(args.name)
        elif args.snap_action == "list" or not args.snap_action:
            list_snapshots()
        elif args.snap_action == "restore":
            restore_snapshot(args.name)

    elif args.command == "net":
        if args.net_action == "bbr":
            enable_bbr()
        elif args.net_action == "dns":
            set_dns(args.provider)
        elif args.net_action == "wifi":
            optimize_wifi_latency()
        else:
            net_parser.print_help()

    elif args.command == "monitor":
        run_live_monitor()

    elif args.command == "keys":
        list_keybinds()

    elif args.command == "backup":
        if args.backup_action == "export":
            export_backup(args.output)
        elif args.backup_action == "import":
            import_backup(args.file)
        else:
            backup_parser.print_help()

    elif args.command == "security":
        if args.sec_action == "audit" or not args.sec_action:
            audit_security()
        elif args.sec_action == "harden":
            harden_system()

    elif args.command == "benchmark":
        run_benchmark()

    elif args.command == "gamemode":
        if args.gm_action == "run":
            run_game(args.command_to_run)
        else:
            gm_parser.print_help()

    elif args.command == "logs":
        show_logs(args.type)

    elif args.command == "port":
        if args.port_action == "kill":
            kill_port(args.port_number)
        else:
            list_ports()

    elif args.command == "docker":
        if args.docker_action == "prune":
            prune_docker()
        elif args.docker_action == "stats":
            show_docker_stats()
        else:
            docker_parser.print_help()

    elif args.command == "env":
        check_sdk_environment()

    elif args.command == "display":
        if getattr(args, "display_action", None) == "night":
            set_night_light(enable=(args.state == "on"), temp_k=args.temp)
        else:
            show_display_info()

    elif args.command == "shell":
        run_aero_shell()

    elif args.command == "temp":
        show_thermals()

    elif args.command == "git":
        if args.git_action == "clean":
            clean_merged_branches()
        elif args.git_action == "scan":
            print_git_workspaces()
        elif args.git_action == "graph":
            show_git_graph()
        elif args.git_action == "churn":
            show_git_churn()
        else:
            check_git_status()

    elif args.command == "cron":
        if args.cron_action == "enable":
            enable_auto_maintenance()
        else:
            show_cron_status()

    elif args.command == "clip":
        if args.clip_action == "clear":
            clear_clipboard()
        elif args.clip_action == "menu":
            show_clipboard_menu()
        elif args.clip_action == "history":
            show_clipboard_menu()
        else:
            clip_parser.print_help()

    elif args.command == "trash":
        if args.trash_action == "empty":
            empty_trash_bin()
        else:
            list_trash_contents()

    elif args.command == "theme":
        if args.theme_action == "set":
            set_theme(args.name)
        elif args.theme_action == "accent":
            apply_accent_color(args.color)
        elif args.theme_action == "auto":
            auto_apply_dynamic_theme()
        else:
            list_themes()

    elif args.command == "ssh":
        if args.ssh_action == "gen":
            generate_ed25519_key(args.email)
        elif args.ssh_action == "copy":
            copy_public_key()
        elif args.ssh_action == "test":
            test_github_auth()
        else:
            check_ssh_status()

    elif args.command == "disk":
        if args.disk_action == "clean-node-modules":
            clean_node_modules(args.dir)
        else:
            find_large_files(args.dir, args.min_mb)

    elif args.command == "share":
        start_file_server(args.path, args.port)

    elif args.command == "battery":
        show_battery_health()

    elif args.command == "audio":
        if args.audio_action == "latency":
            set_audio_latency(args.preset)
        else:
            check_audio_status()

    elif args.command == "bt":
        if args.bt_action == "on":
            toggle_bt_power(True)
        elif args.bt_action == "off":
            toggle_bt_power(False)
        else:
            check_bt_status()

    elif args.command == "vpn":
        if args.vpn_action == "up":
            toggle_wireguard(args.interface, True)
        elif args.vpn_action == "down":
            toggle_wireguard(args.interface, False)
        else:
            check_vpn_status()

    elif args.command == "font":
        if args.font_action == "install":
            install_font(args.name)
        else:
            list_fonts()

    elif args.command == "db":
        if args.db_action == "start":
            start_database(args.name)
        elif args.db_action == "stop":
            stop_database(args.name)
        elif args.db_action == "ui":
            launch_db_ui(args.name, args.port)
        else:
            list_databases()

    elif args.command == "api":
        bench_url(args.url, args.count, args.concurrency)

    elif args.command == "vm":
        run_iso_in_vm(args.iso, args.ram, args.cores)

    elif args.command == "system":
        if args.sys_action == "update":
            update_aero_os()
        else:
            check_system_kernel()

    elif args.command == "layout":
        set_desktop_layout(args.mode)

    elif args.command == "kernel":
        if args.kernel_action == "profile":
            apply_kernel_profile(args.name)
        else:
            audit_kernel_scheduler()

    elif args.command == "vault":
        if args.vault_action == "set":
            vault_set(args.key, args.value)
        elif args.vault_action == "get":
            vault_get(args.key)
        elif args.vault_action == "delete":
            vault_delete(args.key)
        elif args.vault_action == "export":
            vault_export_env()
        else:
            vault_list()

    elif args.command == "live":
        run_live_dashboard(args.port)

    elif args.command == "wallpaper":
        if args.wallpaper_action == "set":
            set_desktop_wallpaper(args.palette)
        elif args.wallpaper_action == "generate":
            generate_wallpaper_svg(args.palette, args.out)
        else:
            set_desktop_wallpaper("cyber-cyan")

    elif args.command == "agent":
        ask_local_agent(args.prompt, args.model, args.shell)

    elif args.command == "perf":
        if args.perf_action == "io":
            audit_io_scheduler()
        else:
            profile_cpu_load(args.time)

    elif args.command == "sandbox":
        code = run_in_sandbox(args.cmd, args.offline, not args.rw, args.ram)
        sys.exit(code)

    elif args.command == "trace":
        if args.trace_action == "dns":
            trace_dns_benchmark(args.domain)
        else:
            trace_tcp_tls_latency(args.host, args.port)

    elif args.command == "clean":
        deep_system_clean(args.dry_run)

    elif args.command == "cert":
        generate_dev_certificate(args.domain, args.out)

    elif args.command == "notify":
        send_notification(args.title, args.message, args.urgency, args.sound)

    elif args.command == "health":
        audit_hardware_health()

    elif args.command == "mock":
        run_mock_server(args.port, args.delay)

    elif args.command == "firewall":
        if args.fw_action == "allow":
            allow_port(args.port, args.proto)
        elif args.fw_action == "block-all":
            block_all_inbound()
        else:
            show_firewall_status()

    elif args.command == "prompt":
        p_str = render_prompt(args.shell)
        print(p_str, end="")

    elif args.command == "store":
        if args.store_action == "install":
            install_app(args.app)
        elif args.store_action == "search":
            print_store_search_results(args.query)
        else:
            list_apps(args.category)

    elif args.command == "flash":
        if args.flash_action == "write":
            flash_iso(args.iso, args.drive)
        else:
            drives = list_usb_drives()
            print("\n💾 Connected Removable Flash Drives:")
            for d in drives:
                print(f" • {d['device']}: {d['model']} ({d['size_gb']} GB)")
            if not drives:
                print(" • No removable USB drives detected.")
            print("")

    elif args.command == "dotfiles":
        if args.dot_action == "import":
            import_dotfiles(args.archive)
        else:
            export_dotfiles(args.out)

    elif args.command == "tunnel":
        start_tunnel(args.port)

    elif args.command == "turbo":
        if args.turbo_action == "mount":
            mount_turbo_ramdisk(args.path, args.size)
        elif args.turbo_action == "unmount":
            unmount_turbo_ramdisk(args.path)
        else:
            mounts = get_active_turbo_mounts()
            print("\n🚀 Active Turbo RAM-Disk Mounts:")
            for m in mounts:
                print(f" • {m['mountpoint']}: {m['device']} ({m['options']})")
            if not mounts:
                print(" • No active Turbo RAM-Disk mounts.")
            print("")

    elif args.command == "snippet":
        if args.snippet_action == "search":
            search_snippets(args.query)
        else:
            list_snippets(args.category)

    elif args.command == "regex":
        test_regex(args.pattern, args.text)

    elif args.command == "diff":
        show_file_diff(args.file_a, args.file_b)

    elif args.command == "qr":
        if args.qr_action == "wifi":
            generate_wifi_qr(args.ssid, args.password, args.auth)
        else:
            render_qr_terminal(args.payload)

    elif args.command == "json":
        if args.json_action == "minify":
            minify_json_str(args.target)
        elif args.json_action == "get":
            query_json_path(args.target, args.path)
        else:
            format_json_str(args.target)

    elif args.command == "uuid":
        generate_uuid()

    elif args.command == "token":
        generate_token(args.len, args.mode)

    elif args.command == "hash":
        compute_hash(args.target, args.algo)

    elif args.command == "base64":
        if args.b64_action == "dec":
            b64_decode_str(args.encoded)
        else:
            b64_encode_str(args.text)

    elif args.command == "jwt":
        decode_jwt_token(args.token)

    elif args.command == "http":
        http_request(args.url, args.method, args.data)

    elif args.command == "dig":
        dns_dig(args.domain)

    elif args.command == "ping":
        ping_host(args.host, args.count)

    elif args.command == "fan":
        if args.fan_action == "set":
            set_fan_profile(args.profile)
        else:
            get_hardware_fan_status()

    elif args.command == "color":
        convert_color(args.hex)

    elif args.command == "time":
        time_execution(args.cmd)

    elif args.command == "osd":
        handle_osd_action(args.action)

    elif args.command == "calc":
        calculate_expression(args.expression)

    elif args.command == "rec":
        if args.rec_action == "stop":
            stop_recording()
        elif args.rec_action == "toggle":
            if is_recording_active():
                stop_recording()
            else:
                start_recording()
        else:
            start_recording(is_gif=getattr(args, "gif", False), region=getattr(args, "region", False))

    elif args.command == "zip":
        compress_archive(args.source, args.destination)

    elif args.command == "unzip":
        extract_archive(args.archive, args.destination)

    elif args.command == "search":
        if args.search_action == "text":
            search_text_content(args.query, args.dir)
        else:
            search_files_by_name(args.pattern, args.dir)

    elif args.command == "wear":
        get_ssd_wear_stats()

    elif args.command == "autotile":
        if args.autotile_action == "stop":
            stop_autotiling()
        elif args.autotile_action == "status":
            running = is_autotile_running()
            print(f"Auto-tiling Daemon Active: {'✅ Yes' if running else '❌ No'}")
        else:
            start_autotiling()

    elif args.command == "wine":
        run_windows_app(args.executable, use_gamemode=not args.no_gamemode)

    elif args.command == "connect":
        if args.connect_action == "share":
            send_file_to_phone(args.file)
        else:
            show_phone_status()

    elif args.command == "appimage":
        if args.appimage_action == "list":
            apps = list_appimages()
            print("\n📦 Integrated Portable AppImages:")
            for a in apps:
                print(f" • {a['name']} ➔ {a['file']}")
            if not apps:
                print(" • No AppImages registered yet.")
            print("")
        elif args.appimage_action == "remove":
            remove_appimage(args.slug)
        else:
            target = getattr(args, "file", None) or getattr(args, "file_fallback", None)
            if target:
                integrate_appimage(target)
            else:
                appimg_p.print_help()

    elif args.command == "zoom":
        if args.zoom_action == "in":
            zoom_in()
        elif args.zoom_action == "out":
            zoom_out()
        elif args.zoom_action == "peek":
            zoom_peek(args.scale, args.duration)
        elif args.zoom_action == "set":
            set_zoom(args.scale)
        else:
            zoom_reset()

    elif args.command == "repair":
        show_repair_summary()


