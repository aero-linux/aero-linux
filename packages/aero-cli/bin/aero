 / ___ |/ /___ / _, _/ /_/ /  / /____/ /  |    / / /_/ //   |  
/_/  |_/_____//_/ |_|\____/  /_____/___/  |_/_/  \____//_/|_|  
    ⚡ The High-Performance AI & Developer Linux Distribution
    """)


def main():
    parser = argparse.ArgumentParser(
        description="Aero Linux Management Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # GPU & Accelerators
    gpu_parser = subparsers.add_parser("gpu", help="Detect hardware and setup NVIDIA CUDA or AMD ROCm drivers")
    gpu_sub = gpu_parser.add_subparsers(dest="gpu_action", help="GPU action")
    gpu_sub.add_parser("setup", help="Auto-detect GPU and configure drivers + Wayland acceleration + Container Toolkit")
    gpu_sub.add_parser("nvidia", help="Install official NVIDIA driver + Wayland KMS + AI Container Toolkit")
    gpu_sub.add_parser("rocm", help="Install AMD ROCm runtime permissions and PyTorch environment variables")

    # Doctor
    doc_parser = subparsers.add_parser("doctor", help="Inspect hardware, kernel, battery, and AI readiness")
    doc_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # Power
    pow_parser = subparsers.add_parser("power", help="Manage power profiles and battery health")
    pow_parser.add_argument("profile", nargs="?", choices=list(PROFILES.keys()), help="Set active power profile")
    pow_parser.add_argument("--threshold", type=int, help="Set battery charge limit (e.g. 80)")

    # Memory
    mem_parser = subparsers.add_parser("memory", help="Optimize RAM, zRAM compaction, and inspect memory")
    mem_parser.add_argument("--optimize", action="store_true", help="Trigger zRAM compaction and cache drop")
    mem_parser.add_argument("--top", action="store_true", help="Show top memory consuming processes")

    # AI
    ai_parser = subparsers.add_parser("ai", help="Local AI runtime & model management")
    ai_sub = ai_parser.add_subparsers(dest="ai_action", help="AI subcommands")
    ai_sub.add_parser("init", help="Install and initialize local Ollama AI runtime")
    ai_sub.add_parser("status", help="Show status of local AI daemon and downloaded models")
    ai_pull = ai_sub.add_parser("pull", help="Download an LLM model")
    ai_pull.add_argument("model", help="Model name (e.g. llama3.2, deepseek-r1:8b, qwen2.5-coder)")
    ai_run = ai_sub.add_parser("run", help="Run an interactive session with a model")
    ai_run.add_argument("model", help="Model name (e.g. llama3.2, qwen2.5-coder)")
    
    ai_calc = ai_sub.add_parser("calc", help="Calculate RAM/zRAM requirements for a model size and quantization")
    ai_calc.add_argument("--params", type=float, default=8.0, help="Model parameters in billions (e.g. 7, 8, 14, 32, 70)")
    ai_calc.add_argument("--quant", default="q4_k_m", help="Quantization (fp16, q8_0, q6_k, q5_k_m, q4_k_m, q3_k_m, q2_k)")
    ai_calc.add_argument("--ctx", type=int, default=4096, help="Context window token size (default: 4096)")

    ai_bench = ai_sub.add_parser("bench", help="Benchmark local inference speed and tok/s throughput")
    ai_bench.add_argument("model", nargs="?", default="deepseek-r1:8b", help="Model to benchmark")

    # Dev Environments
    dev_parser = subparsers.add_parser("dev", help="Instant zero-pollution isolated dev workspaces")
    dev_sub = dev_parser.add_subparsers(dest="dev_action", help="Dev subcommands")
    dev_sub.add_parser("list", help="List all available isolated dev environments")
    dev_run = dev_sub.add_parser("run", help="Run an isolated dev environment in current directory")
    dev_run.add_argument("env", choices=list(ENVIRONMENTS.keys()), help="Environment name (node, python, rust, go, c, postgres, redis)")

    # Package Manager Wrapper
    pkg_parser = subparsers.add_parser("pkg", help="Unified fast package manager and cache pruner")
    pkg_sub = pkg_parser.add_subparsers(dest="pkg_action", help="Package actions")
    pkg_sub.add_parser("update", help="Update all APT and Flatpak repositories")
    pkg_sub.add_parser("clean", help="Prune unused dependencies and clear package caches")
    pkg_in = pkg_sub.add_parser("install", help="Install packages")
    pkg_in.add_argument("packages", nargs="+", help="Package names to install")

    # Snapshot & Rollback
    snap_parser = subparsers.add_parser("snapshot", help="Zero-latency system restore snapshots")
    snap_sub = snap_parser.add_subparsers(dest="snap_action", help="Snapshot subcommands")
    snap_create = snap_sub.add_parser("create", help="Create a new restore snapshot")
    snap_create.add_argument("name", nargs="?", default="", help="Optional snapshot label")
    snap_sub.add_parser("list", help="List available restore points")
    snap_rest = snap_sub.add_parser("restore", help="Restore system from a snapshot")
    snap_rest.add_argument("name", help="Snapshot name/tag to restore")

    # Network & DNS Optimizer
    net_parser = subparsers.add_parser("net", help="Low-latency network, BBR TCP, and DNS optimizer")
    net_sub = net_parser.add_subparsers(dest="net_action", help="Network actions")
    net_sub.add_parser("bbr", help="Enable Google BBR TCP Congestion Control")
    net_dns = net_sub.add_parser("dns", help="Set encrypted DNS-over-TLS provider")
    net_dns.add_argument("provider", choices=list(DNS_PROVIDERS.keys()), help="DNS provider (cloudflare, quad9, google)")
    net_sub.add_parser("wifi", help="Disable WiFi power-save mode for low jitter")

    # Live Monitor
    subparsers.add_parser("monitor", help="Launch live interactive terminal system & AI monitor")

    # Keyboard & Shortcuts Cheatsheet
    subparsers.add_parser("keys", help="Display Aero desktop hotkeys and command shortcuts")

    # Dotfiles Backup & Restore
    backup_parser = subparsers.add_parser("backup", help="Export and restore encrypted dotfile configurations")
    backup_sub = backup_parser.add_subparsers(dest="backup_action", help="Backup actions")
    backup_exp = backup_sub.add_parser("export", help="Export desktop dotfiles to archive")
    backup_exp.add_argument("--output", "-o", help="Custom archive destination path")
    backup_imp = backup_sub.add_parser("import", help="Restore desktop dotfiles from archive")
    backup_imp.add_argument("file", help="Path to archive file")

    # Security & Hardening
    sec_parser = subparsers.add_parser("security", help="Kernel security audit and firewall hardening")
    sec_sub = sec_parser.add_subparsers(dest="sec_action", help="Security actions")
    sec_sub.add_parser("audit", help="Run kernel and network security audit")
    sec_sub.add_parser("harden", help="Apply kernel lockdown and firewall hardening")

    # Benchmark
    subparsers.add_parser("benchmark", help="Run multi-core CPU, RAM bandwidth, and disk benchmark")

    # GameMode
    gm_parser = subparsers.add_parser("gamemode", help="Low-latency game and Wine/Proton launcher optimizer")
    gm_sub = gm_parser.add_subparsers(dest="gm_action", help="GameMode subcommands")
    gm_run = gm_sub.add_parser("run", help="Run command with GameMode optimizations")
    gm_run.add_argument("command_to_run", nargs="+", help="Game executable or command")

    # Logs
    log_parser = subparsers.add_parser("logs", help="Analyze system errors, kernel panics, and boot timings")
    log_parser.add_argument("type", nargs="?", default="error", choices=["error", "kernel", "boot", "all"], help="Log type to inspect")

    # Port Inspector
    port_parser = subparsers.add_parser("port", help="Inspect and kill active listening developer ports")
    port_sub = port_parser.add_subparsers(dest="port_action", help="Port actions")
    port_sub.add_parser("list", help="List active listening ports and services")
    port_kill = port_sub.add_parser("kill", help="Kill process listening on a port")
    port_kill.add_argument("port_number", help="Port number to terminate (e.g. 3000, 5432)")

    # Docker Tools
    docker_parser = subparsers.add_parser("docker", help="Docker engine cleanup and container resource monitor")
    docker_sub = docker_parser.add_subparsers(dest="docker_action", help="Docker actions")
    docker_sub.add_parser("prune", help="Clean unused containers, images, and volumes")
    docker_sub.add_parser("stats", help="Show live CPU and memory usage of running containers")

    # SDK Environment
    env_parser = subparsers.add_parser("env", help="Audit installed SDKs, compilers, and toolchains")
    env_sub = env_parser.add_subparsers(dest="env_action", help="Environment actions")
    env_sub.add_parser("check", help="Check versions of Node, Python, C, Rust, Go, Java, Docker")

    # Display & Wayland
    subparsers.add_parser("display", help="Query Wayland output resolutions, refresh rates, and monitors")

    # Interactive Shell
    subparsers.add_parser("shell", help="Launch interactive Aero developer shell")

    # Thermals & Fan Sensors
    subparsers.add_parser("temp", help="Inspect CPU and GPU hardware core temperatures")

    # Git Tools
    git_parser = subparsers.add_parser("git", help="Developer Git workspace inspector and branch cleaner")
    git_sub = git_parser.add_subparsers(dest="git_action", help="Git actions")
    git_sub.add_parser("status", help="Inspect active repository and uncommitted changes")
    git_sub.add_parser("clean", help="Prune merged local Git branches")
    git_sub.add_parser("graph", help="Show colorized ASCII commit topology graph")
    git_sub.add_parser("churn", help="Show top changed files in recent repository history")

    # Cron & Timers
    cron_parser = subparsers.add_parser("cron", help="Manage automated background maintenance timers")
    cron_sub = cron_parser.add_subparsers(dest="cron_action", help="Cron actions")
    cron_sub.add_parser("status", help="Show active systemd timers")
    cron_sub.add_parser("enable", help="Enable daily automated cache & memory maintenance")

    # Clipboard Manager
    clip_parser = subparsers.add_parser("clip", help="Wayland clipboard manager")
    clip_sub = clip_parser.add_subparsers(dest="clip_action", help="Clipboard actions")
    clip_sub.add_parser("clear", help="Clear all clipboard buffers")

    # Themes
    theme_parser = subparsers.add_parser("theme", help="Desktop aesthetic and palette switcher")
    theme_sub = theme_parser.add_subparsers(dest="theme_action", help="Theme actions")
    theme_sub.add_parser("list", help="List available desktop themes")
    theme_sub.add_parser("auto", help="Auto-sync theme with day/night solar cycle & battery status")
    theme_set = theme_sub.add_parser("set", help="Apply a desktop theme")
    theme_set.add_argument("name", choices=list(THEMES.keys()), help="Theme name (cyber-cyan, tokyo-night, nord, gruvbox)")

    # SSH Tools
    ssh_parser = subparsers.add_parser("ssh", help="Ed25519 SSH key generation, copy, and auth test")
    ssh_sub = ssh_parser.add_subparsers(dest="ssh_action", help="SSH actions")
    ssh_sub.add_parser("status", help="List available SSH keys and permissions")
    ssh_gen = ssh_sub.add_parser("gen", help="Generate a new Ed25519 SSH keypair")
    ssh_gen.add_argument("--email", default="developer@aero-linux.org", help="Key comment/email")
    ssh_sub.add_parser("copy", help="Copy public SSH key to clipboard")
    ssh_sub.add_parser("test", help="Test GitHub SSH authentication")

    # Disk Space Tools
    disk_parser = subparsers.add_parser("disk", help="Disk usage analyzer and large file cleaner")
    disk_sub = disk_parser.add_subparsers(dest="disk_action", help="Disk actions")
    disk_top = disk_sub.add_parser("top", help="Find large files on disk")
    disk_top.add_argument("--dir", default=".", help="Directory to scan")
    disk_top.add_argument("--min-mb", type=int, default=100, help="Minimum file size in MB")
    disk_clean = disk_sub.add_parser("clean-node-modules", help="Prune node_modules folders in directory")
    disk_clean.add_argument("--dir", default=".", help="Root directory to clean")

    # Local Share Server
    share_parser = subparsers.add_parser("share", help="Start instant local network HTTP file server")
    share_parser.add_argument("path", nargs="?", default=".", help="File or directory path to serve")
    share_parser.add_argument("--port", type=int, default=8080, help="Port to listen on (default 8080)")

    # Battery Health
    subparsers.add_parser("battery", help="Inspect lithium battery wear, cycles, and health")

    # Audio Engine
    audio_parser = subparsers.add_parser("audio", help="PipeWire audio latency & DSP buffer management")
    audio_sub = audio_parser.add_subparsers(dest="audio_action", help="Audio actions")
    audio_sub.add_parser("status", help="Show audio server and latency status")
    audio_lat = audio_sub.add_parser("latency", help="Set PipeWire audio latency preset")
    audio_lat.add_argument("preset", choices=list(LATENCY_PRESETS.keys()), help="Latency preset (low, medium, high)")

    # Bluetooth
    bt_parser = subparsers.add_parser("bt", help="Bluetooth controller and power-saving management")
    bt_sub = bt_parser.add_subparsers(dest="bt_action", help="Bluetooth actions")
    bt_sub.add_parser("status", help="Show controller and connected devices")
    bt_sub.add_parser("on", help="Power ON Bluetooth controller")
    bt_sub.add_parser("off", help="Power OFF Bluetooth controller (saves battery)")

    # VPN & Mesh
    vpn_parser = subparsers.add_parser("vpn", help="WireGuard & Tailscale mesh network management")
    vpn_sub = vpn_parser.add_subparsers(dest="vpn_action", help="VPN actions")
    vpn_sub.add_parser("status", help="Show active VPN tunnels")
    vpn_up = vpn_sub.add_parser("up", help="Bring WireGuard tunnel UP")
    vpn_up.add_argument("interface", help="WireGuard interface name (e.g. wg0)")
    vpn_down = vpn_sub.add_parser("down", help="Bring WireGuard tunnel DOWN")
    vpn_down.add_argument("interface", help="WireGuard interface name (e.g. wg0)")

    # Fonts
    font_parser = subparsers.add_parser("font", help="Developer Nerd Font manager")
    font_sub = font_parser.add_subparsers(dest="font_action", help="Font actions")
    font_sub.add_parser("list", help="List available Nerd Fonts")
    font_in = font_sub.add_parser("install", help="Download and install a Nerd Font")
    font_in.add_argument("name", choices=list(NERD_FONTS.keys()), help="Font name")

    # Databases
    db_parser = subparsers.add_parser("db", help="Local containerized database suite")
    db_sub = db_parser.add_subparsers(dest="db_action", help="Database actions")
    db_sub.add_parser("list", help="List supported databases")
    db_start = db_sub.add_parser("start", help="Start a local database container")
    db_start.add_argument("name", choices=list(DATABASES.keys()), help="Database name")
    db_stop = db_sub.add_parser("stop", help="Stop a database container")
    db_stop.add_argument("name", choices=list(DATABASES.keys()), help="Database name")

    # API Benchmarking
    api_parser = subparsers.add_parser("api", help="API load testing and benchmarking")
    api_sub = api_parser.add_subparsers(dest="api_action", help="API actions")
    api_bench = api_sub.add_parser("bench", help="Run HTTP load benchmark against URL")
    api_bench.add_argument("url", help="Target URL (e.g. http://localhost:3000/api/users)")
    api_bench.add_argument("--count", "-c", type=int, default=100, help="Total requests (default 100)")
    api_bench.add_argument("--concurrency", "-w", type=int, default=10, help="Concurrent workers (default 10)")

    # Micro-VMs
    vm_parser = subparsers.add_parser("vm", help="QEMU/KVM micro-VM runner")
    vm_sub = vm_parser.add_subparsers(dest="vm_action", help="VM actions")
    vm_run = vm_sub.add_parser("run", help="Boot ISO file in accelerated micro-VM")
    vm_run.add_argument("iso", help="Path to ISO image")
    vm_run.add_argument("--ram", type=int, default=4096, help="RAM in MB (default 4096)")
    vm_run.add_argument("--cores", type=int, default=4, help="CPU cores (default 4)")

    # System Updater
    sys_parser = subparsers.add_parser("system", help="OS and Kernel upgrade manager")
    sys_sub = sys_parser.add_subparsers(dest="sys_action", help="System actions")
    sys_sub.add_parser("info", help="Check active kernel flavor and release")
    sys_sub.add_parser("update", help="Upgrade base packages and Aero CLI")

    # Desktop Layout Switcher
    layout_parser = subparsers.add_parser("layout", help="Switch between Windows-Friendly and Tiling desktop layouts")
    layout_parser.add_argument("mode", choices=["windows", "tiling"], help="Desktop layout mode (windows or tiling)")

    # Kernel & Sysctl Tuning
    ker_parser = subparsers.add_parser("kernel", help="Kernel scheduler & low-latency sysctl management")
    ker_sub = ker_parser.add_subparsers(dest="kernel_action", help="Kernel actions")
    ker_sub.add_parser("audit", help="Audit active memory, scheduler, and network sysctl parameters")
    ker_prof = ker_sub.add_parser("profile", help="Apply kernel scheduler profile")
    ker_prof.add_argument("name", choices=list(KERNEL_PROFILES.keys()), help="Profile name (lowlatency, throughput, powersave)")

    # Developer Vault & Secrets Keyring
    vault_parser = subparsers.add_parser("vault", help="Encrypted local developer keyring & secrets manager")
    vault_sub = vault_parser.add_subparsers(dest="vault_action", help="Vault actions")
    v_set = vault_sub.add_parser("set", help="Store encrypted secret")
    v_set.add_argument("key", help="Secret variable name (e.g. DATABASE_URL)")
    v_set.add_argument("value", help="Secret value")
    v_get = vault_sub.add_parser("get", help="Retrieve decrypted secret")
    v_get.add_argument("key", help="Secret variable name")
    vault_sub.add_parser("list", help="List all stored keys (values masked)")
    v_del = vault_sub.add_parser("delete", help="Delete secret from vault")
    v_del.add_argument("key", help="Secret variable name")
    vault_sub.add_parser("export", help="Export secrets as .env shell export commands")

    # Live Web Telemetry Dashboard
    live_parser = subparsers.add_parser("live", help="Start real-time web telemetry dashboard server")
    live_parser.add_argument("--port", type=int, default=8080, help="Port to listen on (default: 8080)")

    # Procedural Wallpaper & Lockscreen Generator
    wall_parser = subparsers.add_parser("wallpaper", help="Generate and set procedural cyber wallpapers")
    wall_sub = wall_parser.add_subparsers(dest="wallpaper_action", help="Wallpaper actions")
    w_set = wall_sub.add_parser("set", help="Set desktop wallpaper palette")
    w_set.add_argument("palette", choices=["cyber-cyan", "tokyo-night", "nord", "gruvbox"], help="Color palette")
    w_gen = wall_sub.add_parser("generate", help="Generate wallpaper SVG file")
    w_gen.add_argument("--palette", default="cyber-cyan", help="Color palette")
    w_gen.add_argument("--out", default="", help="Output SVG path")

    # Local AI Assistant / Terminal Agent
    agent_parser = subparsers.add_parser("agent", help="Local AI coding assistant & terminal query engine")
    agent_parser.add_argument("prompt", help="Question, code request, or error to analyze")
    agent_parser.add_argument("--model", help="Override local model name")
    agent_parser.add_argument("--shell", "-s", action="store_true", help="Return command-only answer for shell execution")

    # Low-Level Kernel & CPU Profiler
    perf_parser = subparsers.add_parser("perf", help="Low-level CPU context-switch and I/O scheduler profiler")
    perf_sub = perf_parser.add_subparsers(dest="perf_action", help="Perf actions")
    p_cpu = perf_sub.add_parser("cpu", help="Sample per-core CPU load and context switch rate")
    p_cpu.add_argument("--time", "-t", type=float, default=1.0, help="Sampling duration in seconds")
    perf_sub.add_parser("io", help="Audit NVMe/SSD queue schedulers and rotational flags")

    # Namespace Micro-Sandbox
    sand_parser = subparsers.add_parser("sandbox", help="Run untrusted scripts/packages in isolated Linux namespace jail")
    sand_sub = sand_parser.add_subparsers(dest="sandbox_action", help="Sandbox actions")
    s_run = sand_sub.add_parser("run", help="Run command in micro-jail")
    s_run.add_argument("cmd", nargs="+", help="Command and arguments to execute inside sandbox")
    s_run.add_argument("--offline", action="store_true", help="Unshare network stack")
    s_run.add_argument("--rw", action="store_true", help="Allow read-write in current directory")
    s_run.add_argument("--ram", type=int, default=2048, help="Memory limit in MB (default: 2048)")

    # Network Latency & Socket Tracer
    trace_parser = subparsers.add_parser("trace", help="Network socket, TLS handshake, and DNS latency tracer")
    trace_sub = trace_parser.add_subparsers(dest="trace_action", help="Trace actions")
    t_ping = trace_sub.add_parser("ping", help="Measure DNS, TCP SYN-ACK, and TLS handshake latency")
    t_ping.add_argument("host", nargs="?", default="github.com", help="Target hostname (default: github.com)")
    t_ping.add_argument("--port", "-p", type=int, default=443, help="Port (default: 443)")
    t_dns = trace_sub.add_parser("dns", help="Benchmark latency across top public DNS resolvers")
    t_dns.add_argument("--domain", default="google.com", help="Domain to resolve")

    # Deep System Cache & De-Bloater Cleaner
    clean_parser = subparsers.add_parser("clean", help="Deep developer cache and system de-bloater cleaner")
    clean_parser.add_argument("--dry-run", action="store_true", help="Preview storage that would be cleaned")

    # Local SSL Developer Certificate Generator
    cert_parser = subparsers.add_parser("cert", help="Generate trusted local developer SSL/TLS certificates")
    cert_sub = cert_parser.add_subparsers(dest="cert_action", help="Cert actions")
    c_gen = cert_sub.add_parser("generate", help="Generate local SSL certificate & private key")
    c_gen.add_argument("domain", nargs="?", default="localhost", help="Domain name (default: localhost)")
    c_gen.add_argument("--out", default=".", help="Output directory (default: current directory)")

    # Desktop Notification Broadcaster
    notif_parser = subparsers.add_parser("notify", help="Send desktop toast notification & sound alert")
    notif_parser.add_argument("title", help="Notification title")
    notif_parser.add_argument("message", nargs="?", default="", help="Notification body message")
    notif_parser.add_argument("--urgency", "-u", default="normal", choices=["low", "normal", "critical"], help="Notification urgency")
    notif_parser.add_argument("--sound", "-s", action="store_true", help="Play terminal bell alert")

    # Hardware & NVMe S.M.A.R.T. Health Diagnostics
    subparsers.add_parser("health", help="Inspect NVMe SSD wear, firmware, and CPU throttle events")

    # Local Mock REST API Server
    mock_parser = subparsers.add_parser("mock", help="Start instant local mock REST API & JSON server")
    mock_sub = mock_parser.add_subparsers(dest="mock_action", help="Mock actions")
    m_serve = mock_sub.add_parser("serve", help="Start mock API server")
    m_serve.add_argument("--port", "-p", type=int, default=4000, help="Port to listen on (default: 4000)")
    m_serve.add_argument("--delay", "-d", type=int, default=0, help="Simulated latency in ms (default: 0)")

    # Developer Firewall Manager
    fw_parser = subparsers.add_parser("firewall", help="UFW developer port whitelister and firewall manager")
    fw_sub = fw_parser.add_subparsers(dest="fw_action", help="Firewall actions")
    fw_sub.add_parser("status", help="Show active firewall rules and open ports")
    fw_allow = fw_sub.add_parser("allow", help="Whitelist a port")
    fw_allow.add_argument("port", type=int, help="Port number (e.g. 3000, 5432, 8080)")
    fw_allow.add_argument("--proto", default="tcp", choices=["tcp", "udp"], help="Protocol (default: tcp)")
    fw_sub.add_parser("block-all", help="Enable strict inbound firewall blocking")

    # Fast Shell Prompt Generator
    prompt_parser = subparsers.add_parser("prompt", help="Render ultra-fast git-aware terminal prompt string")
    prompt_parser.add_argument("shell", nargs="?", default="bash", choices=["bash", "zsh", "fish"], help="Target shell")

    # Developer Software Store (1-Click App Center)
    store_parser = subparsers.add_parser("store", help="1-Click developer app store (VS Code, Brave, Docker, Postman)")
    store_sub = store_parser.add_subparsers(dest="store_action", help="Store actions")
    s_list = store_sub.add_parser("list", help="List available developer software")
    s_list.add_argument("--category", "-c", default="", help="Filter by category")
    s_inst = store_sub.add_parser("install", help="Install software by ID")
    s_inst.add_argument("app", help="Application ID (e.g. vscode, brave, docker, obsidian)")

    # Live USB ISO Flasher
    flash_parser = subparsers.add_parser("flash", help="Safe USB ISO flasher tool")
    flash_sub = flash_parser.add_subparsers(dest="flash_action", help="Flash actions")
    flash_sub.add_parser("drives", help="List connected removable USB flash drives")
    f_write = flash_sub.add_parser("write", help="Write ISO file to USB drive")
    f_write.add_argument("iso", help="Path to ISO image")
    f_write.add_argument("drive", help="Target drive device path (e.g. /dev/sdb)")

    # Developer Dotfiles & Configs Backup
    dot_parser = subparsers.add_parser("dotfiles", help="Backup and restore developer shell & desktop configs")
    dot_sub = dot_parser.add_subparsers(dest="dot_action", help="Dotfiles actions")
    d_exp = dot_sub.add_parser("export", help="Export dotfiles to a tarball archive")
    d_exp.add_argument("--out", default=".", help="Output directory")
    d_imp = dot_sub.add_parser("import", help="Restore dotfiles from tarball archive")
    d_imp.add_argument("archive", help="Path to tarball archive")

    args = parser.parse_args()

    if not args.command:
        print_banner()
        parser.print_help()
        sys.exit(0)

    if args.command == "gpu":
        if args.gpu_action == "nvidia":
            setup_nvidia_driver()
        elif args.gpu_action == "rocm":
            setup_rocm_driver()
        elif args.gpu_action == "setup" or not args.gpu_action:
            report = run_doctor()
            nvidia = any(g.get("vendor") == "NVIDIA" for g in report["gpus"])
            amd = any(g.get("vendor") == "AMD" for g in report["gpus"])
            if nvidia:
                setup_nvidia_driver()
            elif amd:
                setup_rocm_driver()
            else:
                print("ℹ️ Standard Integrated Graphics detected. Intel/Mesa drivers are already active.")

    elif args.command == "doctor":
        report = run_doctor()
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print_banner()
            print(f"🖥️  OS: {report['os']} (Kernel: {report['kernel']})")
            print(f"⚙️  CPU: {report['cpu']['model']} ({report['cpu']['cores']} cores) [Governor: {report['cpu']['governor']}]")
            print(f"🧠 RAM: {report['memory']['available_mb']}MB available / {report['memory']['total_mb']}MB total (zRAM Active: {report['memory']['zram_active']})")
            
            if report['gpus']:
                print("🎮 GPU(s):")
                for g in report['gpus']:
                    print(f"   - {g['vendor']}: {g['model']}")
            else:
                print("🎮 GPU: Integrated / Standard Graphics")

            if report['battery']['present']:
                print(f"🔋 Battery: {report['battery']['percentage']}% ({report['battery']['status']})")
            
            print(f"🤖 AI Stack: Docker={report['ai_stack']['docker']}, Ollama={report['ai_stack']['ollama']}, Python={report['ai_stack']['python']}")

    elif args.command == "power":
        if args.threshold:
            success = set_charge_threshold(args.threshold)
            print(f"🔋 Battery charge threshold set to {args.threshold}%: {'Success' if success else 'Failed'}")
        elif args.profile:
            set_profile(args.profile)
            print(f"⚡ Power profile switched to: {args.profile.upper()}")
            print(f"   ℹ️  {PROFILES[args.profile]['description']}")
        else:
            current = get_current_profile()
            print(f"⚡ Current Power Profile: {current.upper()}")
            print("\nAvailable profiles:")
            for name, p in PROFILES.items():
                print(f"   • {name:10} - {p['description']}")

    elif args.command == "memory":
        if args.top or not args.optimize:
            print("🧠 Top 10 Memory Consuming Processes:")
            for p in get_top_memory_processes(10):
                print(f"   PID {p['pid']:<6} {p['mem_percent']:>5.1f}% ({p['rss_mb']:>5}MB) - {p['command']}")
        if args.optimize:
            print("\n🧹 Compacting zRAM and dropping caches...")
            res = compact_memory()
            print(f"✅ Optimization complete! Freed: ~{res['memory_freed_mb']}MB RAM")

    elif args.command == "ai":
        if args.ai_action == "init":
            install_ollama()
        elif args.ai_action == "status":
            st = get_ai_status()
            print(f"🤖 Ollama Installed: {st['ollama_installed']}")
            print(f"🟢 Daemon Running:  {st['ollama_running']}")
            if st["models"]:
                print("📦 Installed Models:")
                for m in st["models"]:
                    print(f"   • {m}")
            else:
                print("📦 No models installed yet. Run 'aero ai pull llama3.2' to get started.")
        elif args.ai_action == "pull":
            pull_model(args.model)
        elif args.ai_action == "run":
            run_model(args.model)
        elif args.ai_action == "calc":
            print_memory_calc(args.params, args.quant, args.ctx)
        elif args.ai_action == "bench":
            benchmark_model_speed(args.model)
        else:
            ai_parser.print_help()

    elif args.command == "dev":
        if args.dev_action == "list" or not args.dev_action:
            list_dev_environments()
        elif args.dev_action == "run":
            run_dev_environment(args.env)

    elif args.command == "pkg":
        if args.pkg_action == "update":
            update_packages()
        elif args.pkg_action == "clean":
            clean_system()
        elif args.pkg_action == "install":
            install_packages(args.packages)
        else:
            pkg_parser.print_help()

    elif args.command == "snapshot":
        if args.snap_action == "create":
            create_snapshot(args.name)
        elif args.snap_action == "list" or not args.snap_action:
            list_snapshots()
        elif args.snap_action == "restore":
            restore_snapshot(args.name)

    elif args.command == "net":
        if args.net_action == "bbr":
            enable_bbr()
        elif args.net_action == "dns":
            set_dns(args.provider)
        elif args.net_action == "wifi":
            optimize_wifi_latency()
        else:
            net_parser.print_help()

    elif args.command == "monitor":
        run_live_monitor()

    elif args.command == "keys":
        list_keybinds()

    elif args.command == "backup":
        if args.backup_action == "export":
            export_backup(args.output)
        elif args.backup_action == "import":
            import_backup(args.file)
        else:
            backup_parser.print_help()

    elif args.command == "security":
        if args.sec_action == "audit" or not args.sec_action:
            audit_security()
        elif args.sec_action == "harden":
            harden_system()

    elif args.command == "benchmark":
        run_benchmark()

    elif args.command == "gamemode":
        if args.gm_action == "run":
            run_game(args.command_to_run)
        else:
            gm_parser.print_help()

    elif args.command == "logs":
        show_logs(args.type)

    elif args.command == "port":
        if args.port_action == "kill":
            kill_port(args.port_number)
        else:
            list_ports()

    elif args.command == "docker":
        if args.docker_action == "prune":
            prune_docker()
        elif args.docker_action == "stats":
            show_docker_stats()
        else:
            docker_parser.print_help()

    elif args.command == "env":
        check_sdk_environment()

    elif args.command == "display":
        show_display_info()

    elif args.command == "shell":
        run_aero_shell()

    elif args.command == "temp":
        show_thermals()

    elif args.command == "git":
        if args.git_action == "clean":
            clean_merged_branches()
        elif args.git_action == "graph":
            show_git_graph()
        elif args.git_action == "churn":
            show_git_churn()
        else:
            check_git_status()

    elif args.command == "cron":
        if args.cron_action == "enable":
            enable_auto_maintenance()
        else:
            show_cron_status()

    elif args.command == "clip":
        if args.clip_action == "clear":
            clear_clipboard()
        else:
            clip_parser.print_help()

    elif args.command == "theme":
        if args.theme_action == "set":
            set_theme(args.name)
        elif args.theme_action == "auto":
            auto_apply_dynamic_theme()
        else:
            list_themes()

    elif args.command == "ssh":
        if args.ssh_action == "gen":
            generate_ed25519_key(args.email)
        elif args.ssh_action == "copy":
            copy_public_key()
        elif args.ssh_action == "test":
            test_github_auth()
        else:
            check_ssh_status()

    elif args.command == "disk":
        if args.disk_action == "clean-node-modules":
            clean_node_modules(args.dir)
        else:
            find_large_files(args.dir, args.min_mb)

    elif args.command == "share":
        start_file_server(args.path, args.port)

    elif args.command == "battery":
        show_battery_health()

    elif args.command == "audio":
        if args.audio_action == "latency":
            set_audio_latency(args.preset)
        else:
            check_audio_status()

    elif args.command == "bt":
        if args.bt_action == "on":
            toggle_bt_power(True)
        elif args.bt_action == "off":
            toggle_bt_power(False)
        else:
            check_bt_status()

    elif args.command == "vpn":
        if args.vpn_action == "up":
            toggle_wireguard(args.interface, True)
        elif args.vpn_action == "down":
            toggle_wireguard(args.interface, False)
        else:
            check_vpn_status()

    elif args.command == "font":
        if args.font_action == "install":
            install_font(args.name)
        else:
            list_fonts()

    elif args.command == "db":
        if args.db_action == "start":
            start_database(args.name)
        elif args.db_action == "stop":
            stop_database(args.name)
        else:
            list_databases()

    elif args.command == "api":
        bench_url(args.url, args.count, args.concurrency)

    elif args.command == "vm":
        run_iso_in_vm(args.iso, args.ram, args.cores)

    elif args.command == "system":
        if args.sys_action == "update":
            update_aero_os()
        else:
            check_system_kernel()

    elif args.command == "layout":
        set_desktop_layout(args.mode)

    elif args.command == "kernel":
        if args.kernel_action == "profile":
            apply_kernel_profile(args.name)
        else:
            audit_kernel_scheduler()

    elif args.command == "vault":
        if args.vault_action == "set":
            vault_set(args.key, args.value)
        elif args.vault_action == "get":
            vault_get(args.key)
        elif args.vault_action == "delete":
            vault_delete(args.key)
        elif args.vault_action == "export":
            vault_export_env()
        else:
            vault_list()

    elif args.command == "live":
        run_live_dashboard(args.port)

    elif args.command == "wallpaper":
        if args.wallpaper_action == "set":
            set_desktop_wallpaper(args.palette)
        elif args.wallpaper_action == "generate":
            generate_wallpaper_svg(args.palette, args.out)
        else:
            set_desktop_wallpaper("cyber-cyan")

    elif args.command == "agent":
        ask_local_agent(args.prompt, args.model, args.shell)

    elif args.command == "perf":
        if args.perf_action == "io":
            audit_io_scheduler()
        else:
            profile_cpu_load(args.time)

    elif args.command == "sandbox":
        code = run_in_sandbox(args.cmd, args.offline, not args.rw, args.ram)
        sys.exit(code)

    elif args.command == "trace":
        if args.trace_action == "dns":
            trace_dns_benchmark(args.domain)
        else:
            trace_tcp_tls_latency(args.host, args.port)

    elif args.command == "clean":
        deep_system_clean(args.dry_run)

    elif args.command == "cert":
        generate_dev_certificate(args.domain, args.out)

    elif args.command == "notify":
        send_notification(args.title, args.message, args.urgency, args.sound)

    elif args.command == "health":
        audit_hardware_health()

    elif args.command == "mock":
        run_mock_server(args.port, args.delay)

    elif args.command == "firewall":
        if args.fw_action == "allow":
            allow_port(args.port, args.proto)
        elif args.fw_action == "block-all":
            block_all_inbound()
        else:
            show_firewall_status()

    elif args.command == "prompt":
        p_str = render_prompt(args.shell)
        print(p_str, end="")

    elif args.command == "store":
        if args.store_action == "install":
            install_app(args.app)
        else:
            list_apps(args.category)

    elif args.command == "flash":
        if args.flash_action == "write":
            flash_iso(args.iso, args.drive)
        else:
            drives = list_usb_drives()
            print("\n💾 Connected Removable Flash Drives:")
            for d in drives:
                print(f" • {d['device']}: {d['model']} ({d['size_gb']} GB)")
            if not drives:
                print(" • No removable USB drives detected.")
            print("")

    elif args.command == "dotfiles":
        if args.dot_action == "import":
            import_dotfiles(args.archive)
        else:
            export_dotfiles(args.out)


if __name__ == "__main__":
    main()
