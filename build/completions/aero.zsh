#compdef aero

_aero() {
    local -a commands
    commands=(
        'doctor:Run real-time hardware diagnostics'
        'memory:Audit RAM allocation & compact zRAM compression buffers'
        'power:Manage TLP power profiles & battery charge thresholds'
        'ai:1-click local LLM inference via Ollama'
        'vault:Local encrypted AES-256 secrets manager'
        'dev:Manage containerized developer stacks'
        'net:Network tuning, BBR, DNS-over-TLS & diagnostics'
        'store:1-click developer software app center'
        'repair:Autonomous system self-repair & diagnostics'
        'git:Multi-repository workspace status monitor'
        'ssh:Manage SSH keys and remote server bookmarks'
        'ssl:Local development HTTPS SSL/TLS certificate generator'
        'firewall:Manage UFW firewall port rules'
        'speed:Measure network latency, DNS speed & CDN throughput'
        'disk:Visual storage breakdown & developer cache cleaner'
        'sync:Developer dotfiles & configuration backup/restore'
        'startup:Manage login autostart applications'
        'services:Control background systemd daemons'
        'flasher:Safe live USB ISO creator'
        'logs:System logs & kernel diagnostic viewer'
        'font:Developer typography & ligature previewer'
        'ports:Real-time dev server listening ports'
        'shortcuts:Searchable keyboard hotkeys cheatsheet'
        'notes:Floating Markdown scratchpad'
        'color:Screen color dropper & palette studio'
        'screenshot:Screen capture & region snip'
        'monitor:Live CPU waveform task manager'
        'updater:System update & security patch manager'
        'wifi:Wi-Fi spectrum scanner & connection dialog'
        'bluetooth:Bluetooth device pairing & battery telemetry'
        'audio:PipeWire audio sink switcher'
        'displays:Display resolution & HiDPI scaling'
        'gamehub:GameMode boost & FPS overlay'
        'phone:Wireless phone sync & drop target'
        'security:System security audit & ASLR check'
        'benchmark:Multi-core CPU & RAM speed test'
        'clean:Purge package cache, logs & pip caches'
        'layout:Switch between Windows & Hacker Tiling modes'
        'zoom:Desktop screen magnifier & fractional scaling'
        'about:Hardware specs & distro details'
        'shell:Interactive developer REPL shell'
        'calc:Instant terminal calculator'
        'diff:Visual file diff & comparator'
        'qr:QR code generator & mobile pairing'
        'archive:Compress & extract archives'
        'sandbox:Multi-language isolated code runner'
        'tunnel:Expose localhost to public HTTPS'
        'markdown:Markdown & technical documentation editor'
        'gpu:GPU mode switcher & telemetry'
        'cron:Scheduled cron tasks manager'
        'crypto:JWT decoder & cryptographic hasher'
        'db:SQLite database explorer & SQL console'
        'env:Project .env & secrets manager'
        'mock:Mock REST API server & webhooks'
        'regex:Regex tester & pattern evaluator'
        'deps:Package & shared library inspector'
        'search:Fast multi-threaded file & text search'
        'turbomount:In-memory RAM-disk turbo compilation'
        'tiling:Dynamic BSP auto-tiling daemon'
        'recorder:Screen & media recorder'
    )

    _describe 'aero command' commands
}

_aero "$@"
